    if [ -n "$hop" ]; then
      v2link=$(printf 'hysteria2://%s@%s:%s/?insecure=1&mport=%s#%s' "$(jq -r .password "$m")" "$ip" "$(jq -r .port "$m")" "$hop" "$(jq -r .name "$m")")
      echo -e "${YEL}v2rayN 扩展链接（mport）：${OFF}"; echo "$v2link"
    fi
  fi
  if [ "$type" = vless ]; then jq -n --arg name "$n" --arg server "$ip" --argjson port "$(jq .port "$m")" --arg uuid "$(jq -r .uuid "$m")" --arg sni "$(jq -r .domain "$m")" --arg fp "$DEFAULT_FP" --arg pbk "$(jq -r .pbk "$m")" --arg sid "$(jq -r .sid "$m")" '{name:$name,type:"vless",server:($server|ltrimstr("[")|rtrimstr("]")),port:$port,uuid:$uuid,encryption:"none",network:"tcp",tls:true,servername:$sni,"client-fingerprint":$fp,"skip-cert-verify":true,udp:true,flow:"xtls-rprx-vision","reality-opts":{"public-key":$pbk,"short-id":$sid}}'; fi
  if [ "$type" = tuic ]; then
    local alpn; alpn=$(jq -ce '.inbounds[0].tls.alpn | select(type=="array" and length>0)' "$CONF/$n.json") || return 1
    jq --arg server "$ip" --argjson alpn "$alpn" '{name,type:"tuic",server:($server|ltrimstr("[")|rtrimstr("]")),port,uuid,password,sni:"meruru",alpn:$alpn,"skip-cert-verify":true,"congestion-controller":"bbr","udp-relay-mode":"native","reduce-rtt":false,udp:true}' "$m"
    echo "请在云安全组放行 UDP $(jq -r .port "$m")；客户端 ALPN 使用 $alpn。"
  fi
  if [ "$type" = vless-ws ]; then
    jq '{name,type:"vless",server:.domain,port:443,uuid,tls:true,servername:.domain,"skip-cert-verify":false,network:"ws",udp:true,"ws-opts":{path:.path,headers:{Host:.domain}}}' "$m"
    echo "内部 TCP 端口：$(jq -r .port "$m")（仅本机）；客户端入口：$(jq -r .domain "$m"):443"
  elif [ "$type" = trojan ]; then
    jq '{name,type:"trojan",server:.domain,port,password,sni:.domain,"skip-cert-verify":false,udp:true}' "$m"
  fi
  command -v qrencode >/dev/null && qrencode -t ANSIUTF8 "$link"
}
node_picker() { # Prints stable numbered nodes and stores the selected safe filename in NODE_SELECTED.

      elif [ "$type" = vless-ws ]; then
        new="/meruru-$(openssl rand -hex 12)"
        jq --arg p "$new" '.inbounds[0].transport.path=$p' "$f" >"$f.tmp" && mv "$f.tmp" "$f"
        jq --arg p "$new" '.path=$p' "$m" >"$m.tmp" && mv "$m.tmp" "$m"
        update_transaction "$n" && show_node "$n"
      elif [ "$type" = vless ] || [ "$type" = anytls ]; then

caddy_port_conflict() { # Ignore only TCP listeners owned by our running Caddy service.
  local p=$1 pid listeners
  listeners=$(ss -H -ltnp "sport = :$p" 2>/dev/null)
  [ -n "$listeners" ] || return 1
  pid=$(systemctl show meruru-caddy.service -p MainPID --value 2>/dev/null)
  if [[ "$pid" =~ ^[1-9][0-9]*$ ]]; then
    listeners=$(printf '%s\n' "$listeners" | grep -v "pid=$pid,")
  fi
  [ -n "$listeners" ]
}
caddy_self_domain() {
  local snapshot active=0 enabled=0 confirm backend proto p
  if [ -f "$CADDY_DIR/site/index.html" ] && ! grep -Fq '<title>微光 ·' "$CADDY_DIR/site/index.html"; then
    read -r -p '已有自定义网页，继续配置并允许替换？[y/N] ' confirm
    [[ "$confirm" =~ ^[Yy]$ ]] || return 1
  fi
  snapshot=$(mktemp -d "$MERURU_HOME/.caddy-config-backup.XXXXXX") || return 1
  if [ -d "$CADDY_DIR" ]; then cp -a "$CADDY_DIR" "$snapshot/original" || return 1; fi
  [ ! -f "$CADDY_SERVICE" ] || cp -p "$CADDY_SERVICE" "$snapshot/service"
  if [ -f "$MERURU_HOME/firewall-owned.tsv" ]; then cp "$MERURU_HOME/firewall-owned.tsv" "$snapshot/ledger"; else : >"$snapshot/ledger"; fi
  systemctl is-active --quiet meruru-caddy.service && active=1
  systemctl is-enabled --quiet meruru-caddy.service && enabled=1
  if caddy_configure_inner; then
    sleep 1
    if systemctl is-active --quiet meruru-caddy.service; then echo "  配置前备份：$snapshot"; return 0; fi
  fi
  systemctl stop meruru-caddy.service >/dev/null 2>&1 || true
  if [ -d "$CADDY_DIR" ]; then mv "$CADDY_DIR" "$snapshot/failed"; fi
  [ ! -d "$snapshot/original" ] || cp -a "$snapshot/original" "$CADDY_DIR"
  if [ -f "$snapshot/service" ]; then cp -p "$snapshot/service" "$CADDY_SERVICE"; else rm -f "$CADDY_SERVICE"; systemctl disable meruru-caddy.service >/dev/null 2>&1 || true; fi
  if [ -f "$MERURU_HOME/firewall-owned.tsv" ]; then
    awk 'FILENAME==ARGV[1]{seen[$0]=1;next}!seen[$0]' "$snapshot/ledger" "$MERURU_HOME/firewall-owned.tsv" >"$snapshot/new-rules"
    cp "$snapshot/new-rules" "$MERURU_HOME/firewall-owned.tsv"
    while IFS=$'\t' read -r backend proto p; do [ -z "$p" ] || firewall_close "$proto" "$p"; done <"$snapshot/new-rules"
  fi
  cp "$snapshot/ledger" "$MERURU_HOME/firewall-owned.tsv"
  systemctl daemon-reload
  if [ "$enabled" = 1 ]; then systemctl enable meruru-caddy.service; else systemctl disable meruru-caddy.service >/dev/null 2>&1 || true; fi
  [ "$active" = 0 ] || systemctl start meruru-caddy.service
  die "Caddy 配置未提交；页面、服务文件、元数据已恢复。备份：$snapshot"
}
caddy_configure_inner() { # A real HTTPS site on :443 becomes a coherent Reality handshake destination for a domain the user controls.
  local domain upstream email resolved public_raw mode old_domain staged backup m storage was_running=0
  echo -e "${YEL}偷自己 · 自有域名 HTTPS 回落（Caddy）${OFF}"
  echo '用自己的域名提供真实 HTTPS 站点，作为 VLESS / AnyTLS REALITY 握手目标。'
  echo 'Caddy 使用 TCP 80/443；REALITY 节点请选择其他监听端口。'
  echo '前提：域名的 A 记录必须已指向本机公网 IPv4，且 TCP 80/443 未被其他服务占用。'
  old_domain=$(cat "$CADDY_DIR/domain" 2>/dev/null || true)
  [ -z "$old_domain" ] || echo "当前自有域名：$old_domain（输入新域名将替换当前站点）"
  read -r -p "你的域名${old_domain:+ [$old_domain]}：" domain || return 1; domain=${domain:-$old_domain}; domain=${domain,,}; [[ "$domain" =~ ^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?(\.[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?)+$ ]] || { die '域名格式无效。'; return; }
  if [ -n "$old_domain" ] && [ "$domain" != "$old_domain" ]; then
    for m in "$META"/*.meta; do
      [ -f "$m" ] || continue
      if jq -e --arg d "$old_domain" '(.type=="vless-ws" or .type=="trojan" or .type=="vless" or .type=="anytls") and .domain==$d' "$m" >/dev/null; then
        die '已有 TLS / WS / REALITY 节点依赖当前域名；请先修改或删除依赖节点，再更换 Caddy 域名。'; return 1
      fi
    done
  fi
  caddy_port_conflict 80 && { die 'TCP 80 被 MERURU Caddy 以外的服务占用。'; return; }; caddy_port_conflict 443 && { die 'TCP 443 被 MERURU Caddy 以外的服务占用。'; return; }
  resolved=$(getent ahostsv4 "$domain" 2>/dev/null | awk 'NR==1{print $1}'); public_raw=$(curl -4fsS --max-time 5 https://api.ipify.org 2>/dev/null || true)
  [ -n "$resolved" ] && [ -n "$public_raw" ] && [ "$resolved" = "$public_raw" ] || { die "DNS A 记录尚未指向本机公网 IPv4（解析：${resolved:-无}；本机：${public_raw:-未知}）。"; return; }
  ui_section '站点内容'; ui_item 1 '微光 · 祝愿墙（默认，无需额外服务）'; ui_item 2 '反向代理到指定的 HTTPS 上游'
  read -r -p '选择 [1]：' mode || return 1; mode=${mode:-1}; upstream=
  if [ "$mode" = 2 ]; then
    read -r -p 'HTTPS 上游地址（例如 https://www.example.com，不带路径）：' upstream || return 1
    upstream=${upstream%/}
    [[ "$upstream" =~ ^https://[A-Za-z0-9.-]+(:[1-9][0-9]{0,4})?$ ]] || { die '仅接受不含路径、查询或凭据的 HTTPS 上游地址。'; return 1; }
  elif [ "$mode" != 1 ]; then return 1; fi
  read -r -p 'ACME 邮箱（可留空）：' email || return 1
  [[ -z "$email" || "$email" =~ ^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}$ ]] || { die '邮箱格式无效。'; return 1; }
  [ -x "$CADDY_BIN" ] || download_caddy || return
  mkdir -p "$CADDY_DIR" || return 1
  # Preserve existing ACME accounts/certificates rather than requesting new ones.
  storage=$(cat "$CADDY_DIR/storage-root" 2>/dev/null || true)
  if [ -z "$storage" ]; then
    if [ -d /caddy/certificates ]; then storage=/caddy
    elif [ -d /root/.local/share/caddy/certificates ]; then storage=/root/.local/share/caddy
    else storage="$CADDY_DIR/storage"; fi
  fi
  [[ "$storage" = /* && "$storage" != *[[:space:]]* ]] || { die 'Caddy 存储路径无效。'; return 1; }
  mkdir -p "$storage" || return 1
  [ -f "$CADDY_DIR/ws-routes.caddy" ] || : >"$CADDY_DIR/ws-routes.caddy"
  [ "$mode" != 1 ] || write_wishwall || return 1
  staged=$(mktemp "$CADDY_DIR/Caddyfile.staged.XXXXXX") || return 1
  {
    echo '{'; [ -n "$email" ] && printf '  email %s\n' "$email"
    printf '  storage file_system {\n    root %s\n  }\n' "$storage"
    echo '}'
    printf '%s {\n  encode zstd gzip\n  header -Server\n' "$domain"
    printf '  import %s/ws-routes.caddy\n' "$CADDY_DIR"
    if [ -n "$upstream" ]; then printf '  reverse_proxy %s {\n    header_up Host {upstream_hostport}\n  }\n' "$upstream"; else printf '  root * %s/site\n  file_server\n' "$CADDY_DIR"; fi
    echo '}'
  } >"$staged"
  "$CADDY_BIN" validate --config "$staged" --adapter caddyfile || { rm -f "$staged"; die 'Caddyfile 校验失败，原配置未改动。'; return; }
  backup=$(mktemp "$CADDY_DIR/Caddyfile.backup.XXXXXX") || { rm -f "$staged"; return 1; }
  if [ -f "$CADDY_DIR/Caddyfile" ]; then cp "$CADDY_DIR/Caddyfile" "$backup"; fi
  systemctl is-active --quiet meruru-caddy.service && was_running=1
  mv "$staged" "$CADDY_DIR/Caddyfile"
  cat >"$CADDY_SERVICE" <<EOF
[Unit]
Description=MERURU Caddy self-domain HTTPS fallback
After=network-online.target
Wants=network-online.target
[Service]
Type=simple
Environment=HOME=/root
WorkingDirectory=$CADDY_DIR
ExecStart=$CADDY_BIN run --environ --config $CADDY_DIR/Caddyfile --adapter caddyfile
ExecReload=$CADDY_BIN reload --config $CADDY_DIR/Caddyfile --adapter caddyfile
Restart=on-failure
RestartSec=3
LimitNOFILE=1048576
[Install]
WantedBy=multi-user.target
EOF
  firewall_open tcp 80 && firewall_open tcp 443 || return 1
  systemctl daemon-reload; systemctl enable meruru-caddy.service >/dev/null 2>&1
  if { [ "$was_running" = 1 ] && systemctl reload meruru-caddy.service; } || { [ "$was_running" = 0 ] && systemctl start meruru-caddy.service; }; then
    printf '%s\n' "$domain" >"$CADDY_DIR/domain"; printf '%s\n' "$storage" >"$CADDY_DIR/storage-root"; rm -f "$backup"
  else
    if [ -s "$backup" ]; then mv "$backup" "$CADDY_DIR/Caddyfile"; [ "$was_running" = 0 ] || systemctl reload meruru-caddy.service
    else rm -f "$backup" "$CADDY_DIR/Caddyfile"; fi
    die 'Caddy 应用失败，已恢复原配置；日志：journalctl -u meruru-caddy.service -n 80 --no-pager'; return 1
  fi
  echo -e "${GRN}Caddy 已启动。证书申请日志：journalctl -u meruru-caddy.service -f${OFF}"
  echo "证书签发后，可在创建或修改 VLESS / AnyTLS 时选择“偷自己”。"
  echo "自有站点：https://$domain；REALITY 握手目标：$domain:443。"
  return 0
}
enable_bbr() {
  local available old_qdisc old_cc staged file=${BBR_CONFIG:-/etc/sysctl.d/99-meruru-bbr.conf}
  available=$(sysctl -n net.ipv4.tcp_available_congestion_control) || return 1
  if ! grep -qw bbr <<<"$available"; then
    if command -v modprobe >/dev/null; then modprobe tcp_bbr || true; fi
    available=$(sysctl -n net.ipv4.tcp_available_congestion_control) || return 1
  fi
  grep -qw bbr <<<"$available" || { die '当前内核不提供 BBR，未写入持久配置。'; return 1; }
  old_qdisc=$(sysctl -n net.core.default_qdisc) && old_cc=$(sysctl -n net.ipv4.tcp_congestion_control) || return 1
  staged=$(mktemp "${file}.XXXXXX") || return 1
  printf 'net.core.default_qdisc=fq\nnet.ipv4.tcp_congestion_control=bbr\n' >"$staged" || { rm -f "$staged"; return 1; }
  # Apply only our settings, not every unrelated sysctl file on the machine.
  if ! sysctl -p "$staged" || ! mv -f "$staged" "$file"; then
    sysctl -w "net.core.default_qdisc=$old_qdisc" "net.ipv4.tcp_congestion_control=$old_cc" || true
    rm -f "$staged"; die 'BBR 应用失败，已尝试恢复原值；原持久配置保留。'; return 1
  fi
  sysctl net.ipv4.tcp_congestion_control
}
diagnose_hy2() {
  local n m p hop range first last
  echo -e "${CYA}Hysteria2 端口跳跃诊断${OFF}"
  node_picker || return; n=$NODE_SELECTED; m="$META/$n.meta"
  [ "$(jq -r .type "$m")" = hysteria2 ] || { die '所选节点不是 Hysteria2。'; return; }
  p=$(jq -r .port "$m"); hop=$(jq -r '.hop // empty' "$m"); range=${hop/-/:}
  echo "节点：$(jq -r .name "$m")  基础监听 UDP：$p  跳跃范围：${hop:-未启用}"
  systemctl is-active --quiet meruru.service && echo -e "服务：${GRN}运行中${OFF}" || echo -e "服务：${RED}未运行${OFF}"
  if ss -H -lunp 2>/dev/null | grep -E "(:|\\])${p}[[:space:]]"; then :; else echo "UDP 监听：未发现基础端口 $p"; fi
  if [ -n "$hop" ]; then
    IFS=- read -r first last <<<"$hop"
    for tool in iptables ip6tables; do
      command -v "$tool" >/dev/null || continue
      if "$tool" -t nat -C PREROUTING -p udp --dport "$range" -j REDIRECT --to-ports "$p" 2>/dev/null; then
        echo "$tool NAT：已安装  $hop → $p"
        echo "$tool NAT 命中计数（测速后再次运行本诊断观察）："
        "$tool" -t nat -nvL PREROUTING 2>/dev/null | grep -F "dpt:${first}:${last}" || true
      else echo "$tool NAT：缺失  $hop → $p"; fi
    done
    if command -v ufw >/dev/null && ufw status 2>/dev/null | grep -q 'Status: active'; then ufw status | grep -E "${p}|${range}" || echo "UFW：未发现 $p 或 $hop 的可见放行规则"; fi
    echo -e "${YEL}注意：Mihomo 的 ports=$hop 会忽略基础 port=$p；云厂商安全组必须放行 UDP $hop（不仅是 $p）。${OFF}"
  fi
  echo '最近服务日志：'; journalctl -u meruru.service -n 20 --no-pager
}
service_check() {
  case "$1" in
    meruru.service) "$MERURU_BIN" check -c "$MAIN" -C "$CONF";;
    meruru-caddy.service) [ -x "$CADDY_BIN" ] && [ -f "$CADDY_DIR/Caddyfile" ] || { die '尚未配置 Caddy，请先进入 13「偷自己」。'; return 1; }
      "$CADDY_BIN" validate --config "$CADDY_DIR/Caddyfile" --adapter caddyfile;;
    *) return 1;;
  esac
}
service_action() {
  local unit=$1 action=$2
  case "$unit" in meruru.service) [ -f "$SERVICE" ] || { die 'MERURU 服务文件缺失。'; return 1; };;
    meruru-caddy.service) [ -f "$CADDY_SERVICE" ] || { die '尚未配置 Caddy，请先进入 13「偷自己」。'; return 1; };;
    *) return 1;; esac
  case "$action" in
    start|restart) service_check "$unit" || { die '配置检查失败，未执行启停操作。'; return 1; };;
    stop|enable|disable) :;;
    *) return 1;;
  esac
  timeout 10 systemctl daemon-reload && timeout 25 systemctl "$action" "$unit" || { die '操作失败或超时。'; journalctl -u "$unit" -n 25 --no-pager; return 1; }
  if [ "$action" = start ] || [ "$action" = restart ]; then
    sleep 1
    timeout 5 systemctl is-active --quiet "$unit" || { die '服务未保持运行，请检查以下日志。'; journalctl -u "$unit" -n 25 --no-pager; return 1; }
  fi
  echo -e "${GRN}操作已完成。${OFF}"
}

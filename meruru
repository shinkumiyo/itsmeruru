#!/usr/bin/env bash
# meruru - self-contained sing-box manager (Debian/Ubuntu first; common RPM systems supported)
# Install: bash /root/meruru; then use M or m.
# This script intentionally never resolves or invokes a system "sing-box" command.

MERURU_HOME=/etc/meruru
MERURU_BIN="$MERURU_HOME/bin/sing-box"
CONF="$MERURU_HOME/conf"
META="$MERURU_HOME/meta"
MAIN="$MERURU_HOME/config.json"
HOP="$MERURU_HOME/apply_hop.sh"
SERVICE=/etc/systemd/system/meruru.service
CADDY_BIN="$MERURU_HOME/bin/caddy"
CADDY_DIR="$MERURU_HOME/caddy"
CADDY_SERVICE=/etc/systemd/system/meruru-caddy.service
COMMAND_DIR=/usr/local/bin
MERURU_VERSION=2026.10.30.5
UPDATE_URL=https://raw.githubusercontent.com/shinkumiyo/itsmeruru/main/meruru
LEGACY_HOME=/etc/sbx
LEGACY_SERVICE=/etc/systemd/system/sbx.service
LEGACY_CADDY_SERVICE=/etc/systemd/system/sbx-caddy.service
RED='\033[31m'; GRN='\033[32m'; YEL='\033[33m'; CYA='\033[36m'; OFF='\033[0m'
DEFAULT_FP=safari
SNI_MAX_RTT_MS=30
BOLD='\033[1m'; DIM='\033[2m'
# Open horizontal rules keep Chinese labels aligned across terminal fonts.
ui_rule() { printf '%b  ──────────────────────────────────────────────%b\n' "$DIM" "$OFF"; }
ui_title() { printf '\n%b  meruru%b  /  %s\n' "$BOLD$CYA" "$OFF" "$1"; ui_rule; }
ui_section() { printf '\n%b  %s%b\n' "$DIM" "$1" "$OFF"; }
ui_item() { printf '  %b%2s%b  %s\n' "$CYA" "$1" "$OFF" "$2"; }

die() { echo -e "${RED}Error: $*${OFF}" >&2; return 1; }
need_root() { [ "${EUID:-$(id -u)}" -eq 0 ] || { die 'Run as root.'; exit 1; }; }
pause() { printf '\n'; read -r -p '  按 Enter 继续 … ' _; }
safe_name() { [[ "$1" =~ ^[A-Za-z0-9_-]{1,48}$ ]]; }
json() { jq -cn "$@"; }
uuid() {
  if [ -r /proc/sys/kernel/random/uuid ]; then cat /proc/sys/kernel/random/uuid; return; fi
  local hex; hex=$(openssl rand -hex 16) || return 1
  printf '%s-%s-4%s-8%s-%s\n' "${hex:0:8}" "${hex:8:4}" "${hex:13:3}" "${hex:17:3}" "${hex:20:12}"
}
port() { [[ "$1" =~ ^[1-9][0-9]{0,4}$ ]] && [ "$1" -le 65535 ]; }
valid_index() { [[ "$1" =~ ^[0-9]{1,6}$ ]] && [ "$((10#$1))" -ge 1 ] && [ "$((10#$1))" -le "$2" ]; }
public_address_valid() {
  local ip=${1#[}; ip=${ip%]}
  if [[ "$ip" =~ ^([0-9]{1,3})\.([0-9]{1,3})\.([0-9]{1,3})\.([0-9]{1,3})$ ]]; then
    local a=$((10#${BASH_REMATCH[1]})) b=$((10#${BASH_REMATCH[2]})) c=$((10#${BASH_REMATCH[3]})) d=$((10#${BASH_REMATCH[4]}))
    [ "$a" -ge 1 ] && [ "$a" -lt 224 ] && [ "$b" -le 255 ] && [ "$c" -le 255 ] && [ "$d" -le 255 ] || return 1
    case "$a.$b" in 10.*|127.*|169.254|192.168) return 1;;esac
    [ "$a" != 172 ] || [ "$b" -lt 16 ] || [ "$b" -gt 31 ] || return 1
    [ "$a" != 100 ] || [ "$b" -lt 64 ] || [ "$b" -gt 127 ] || return 1
    return 0
  fi
  [[ "$ip" =~ ^[0-9A-Fa-f:]+$ && "$ip" = *:* ]] || return 1
  [[ "$ip" != :* || "$ip" = ::* ]] && [[ "$ip" != *: || "$ip" = *:: ]] || return 1
  local piece count=0 expanded=$ip; local -a pieces=()
  [[ "$ip" != *:::* ]] || return 1
  if [[ "$ip" = *::* ]]; then expanded=${ip/::/:}; [[ "$expanded" != *::* ]] || return 1; fi
  IFS=: read -r -a pieces <<<"$expanded"
  for piece in "${pieces[@]}"; do [ -n "$piece" ] || continue; [[ "$piece" =~ ^[0-9A-Fa-f]{1,4}$ ]] || return 1; count=$((count+1)); done
  if [[ "$ip" = *::* ]]; then [ "$count" -lt 8 ] || return 1; else [ "$count" = 8 ] || return 1; fi
  case "${ip,,}" in ::|::1|fc*|fd*|fe8*|fe9*|fea*|feb*|ff*)return 1;;esac
}
public_ip() {
  local ip
  for endpoint in https://api.ipify.org https://icanhazip.com; do
    ip=$(curl -4fsS --connect-timeout 2 --max-time 4 "$endpoint" 2>/dev/null | tr -d '[:space:]')
    if public_address_valid "$ip"; then printf '%s' "$ip"; return 0; fi
  done
  ip=$(curl -6fsS --connect-timeout 2 --max-time 4 https://api64.ipify.org 2>/dev/null | tr -d '[:space:]')
  if public_address_valid "$ip"; then printf '[%s]' "$ip"; return 0; fi
  [ -t 0 ] || { die '无法获取公网地址，请检查网络或手动配置节点服务器地址。'; return 1; }
  read -r -p '无法识别公网地址，请输入服务器公网 IP：' ip
  public_address_valid "$ip" || { die '不是有效的公网地址。'; return 1; }
  ip=${ip#[}; ip=${ip%]}
  [[ "$ip" != *:* ]] && printf '%s' "$ip" || printf '[%s]' "$ip"
}
restart() {
  timeout 10 systemctl daemon-reload && timeout 25 systemctl restart meruru.service || return 1
  sleep 1
  timeout 5 systemctl is-active --quiet meruru.service || { journalctl -u meruru.service -n 25 --no-pager; return 1; }
}
secure_state() {
  chmod 700 "$MERURU_HOME" "$CONF" "$META" "$MERURU_HOME/certs" "$MERURU_HOME/bin" || return 1
  find "$CONF" "$META" "$MERURU_HOME/certs" -type f -exec chmod 600 {} +
  [ ! -f "$MAIN" ] || chmod 600 "$MAIN"
}
manager_lock() {
  mkdir -p /run/meruru && chmod 700 /run/meruru || return 1
  exec 9>/run/meruru/manager.lock
  flock -n 9 || { die '另一个管理会话正在运行，请先退出该会话。'; return 1; }
}

pkg_install() {
  local cmd manager pkg ca_missing=0; local -a missing=() pkgs=()
  for cmd in curl jq openssl tar gzip unzip iptables ip6tables qrencode ss dig getent hostname timeout mktemp sort shuf date install readlink sha256sum awk sed grep find flock; do
    command -v "$cmd" >/dev/null 2>&1 || missing+=("$cmd")
  done
  [ -s /etc/ssl/certs/ca-certificates.crt ] || [ -s /etc/pki/tls/certs/ca-bundle.crt ] || [ -s /etc/ssl/cert.pem ] || ca_missing=1
  [ "${#missing[@]}" -gt 0 ] || [ "$ca_missing" = 1 ] || return 0
  ui_title '安装前置组件'
  echo "  缺少工具：${missing[*]:-无}"
  [ "$ca_missing" = 0 ] || echo '  缺少系统 CA 证书包。'
  if command -v apt-get >/dev/null; then manager=apt
  elif command -v dnf >/dev/null; then manager=dnf
  elif command -v yum >/dev/null; then manager=yum
  else die '自动安装支持 Debian / Ubuntu 和常见 RPM 发行版；当前未找到包管理器。'; return 1; fi
  for cmd in "${missing[@]}"; do
    case "$cmd" in
      iptables|ip6tables) pkg=iptables;;
      ss) [ "$manager" = apt ] && pkg=iproute2 || pkg=iproute;;
      dig) [ "$manager" = apt ] && pkg=dnsutils || pkg=bind-utils;;
      getent) [ "$manager" = apt ] && pkg=libc-bin || pkg=glibc-common;;
      flock) pkg=util-linux;;
      timeout|mktemp|sort|shuf|date|install|readlink|sha256sum) pkg=coreutils;;
      awk) pkg=gawk;;find) pkg=findutils;;*) pkg=$cmd;;
    esac
    [[ " ${pkgs[*]} " = *" $pkg "* ]] || pkgs+=("$pkg")
  done
  [ "$ca_missing" = 0 ] || pkgs+=(ca-certificates)
  echo "  安装软件包：${pkgs[*]}"
  case "$manager" in
    apt) DEBIAN_FRONTEND=noninteractive apt-get -o APT::Update::Error-Mode=any update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends "${pkgs[@]}" || { die '依赖安装失败，请检查软件源、系统时间及 apt 锁。'; return 1; };;
    dnf|yum) "$manager" install -y "${pkgs[@]}" || { die '依赖安装失败，请检查软件源及包管理器日志。'; return 1; };;
  esac
  hash -r
  for cmd in "${missing[@]}"; do command -v "$cmd" >/dev/null 2>&1 || { die "安装后仍缺少 $cmd，停止初始化。"; return 1; }; done
  echo -e "${GRN}前置组件已就绪。${OFF}"
}

download_core() {
  local arch asset url tmp ver
  case "$(uname -m)" in x86_64|amd64) arch=amd64;; aarch64|arm64) arch=arm64;; *) die "Unsupported architecture: $(uname -m)"; return;; esac
  echo 'Fetching latest stable sing-box release from GitHub...'
  url=$(curl -fsSL --retry 3 --connect-timeout 10 --max-time 30 https://api.github.com/repos/SagerNet/sing-box/releases/latest | jq -r --arg a "linux-$arch.tar.gz" '.assets[] | select(.name | endswith($a)) | .browser_download_url' | head -n1)
  [ -n "$url" ] && [ "$url" != null ] || { die 'Could not find the Linux release asset.'; return; }
  ver=$(basename "$url" | sed -E 's/^sing-box-([0-9]+\.[0-9]+\.[0-9]+).*/\1/')
  [ "$(printf '%s\n' 1.12.0 "$ver" | sort -V | head -n1)" = 1.12.0 ] || { die "Latest release $ver is older than 1.12.0."; return; }
  tmp=$(mktemp -d) || return 1
  curl -fL --retry 3 --connect-timeout 15 --max-time 180 --speed-time 20 --speed-limit 1024 "$url" -o "$tmp/core.tar.gz" || { rm -rf "$tmp"; return 1; }
  tar -xzf "$tmp/core.tar.gz" -C "$tmp" || { rm -rf "$tmp"; return 1; }
  asset=$(find "$tmp" -type f -name sing-box | head -n1)
  [ -n "$asset" ] && chmod 755 "$asset" && "$asset" version || { rm -rf "$tmp"; die 'Downloaded core cannot run.'; return 1; }
  install -D -m 755 "$asset" "$MERURU_BIN" || { rm -rf "$tmp"; return 1; }
  rm -rf "$tmp"
}

download_caddy() { # Independent Caddy binary: no third-party installer or system package is used.
  local arch url tmp
  case "$(uname -m)" in x86_64|amd64) arch=amd64;; aarch64|arm64) arch=arm64;; *) die "Caddy unsupported architecture: $(uname -m)"; return 1;; esac
  echo 'Fetching latest stable Caddy release from GitHub...'
  url=$(curl -fsSL --retry 3 --connect-timeout 10 --max-time 30 https://api.github.com/repos/caddyserver/caddy/releases/latest | jq -r --arg a "linux_$arch.tar.gz" '.assets[] | select(.name | endswith($a)) | .browser_download_url' | head -n1)
  [ -n "$url" ] && [ "$url" != null ] || { die 'Could not find a Caddy Linux release asset.'; return 1; }
  tmp=$(mktemp -d) || return 1
  curl -fL --retry 3 --connect-timeout 15 --max-time 180 --speed-time 20 --speed-limit 1024 "$url" -o "$tmp/caddy.tar.gz" || { rm -rf "$tmp"; return 1; }
  tar -xzf "$tmp/caddy.tar.gz" -C "$tmp" || { rm -rf "$tmp"; return 1; }
  install -D -m 755 "$(find "$tmp" -type f -name caddy | head -n1)" "$CADDY_BIN" || { rm -rf "$tmp"; return 1; }
  "$CADDY_BIN" version || { rm -f "$CADDY_BIN"; rm -rf "$tmp"; die 'Downloaded Caddy cannot run.'; return 1; }
  rm -rf "$tmp"
}

write_hop_script() {
  cat >"$HOP" <<'EOF'
#!/usr/bin/env bash
# Generated rules are intentionally reconstructed from metadata on each service start.
set +e
failed=0
for m in /etc/meruru/meta/*.meta; do
  [ -f "$m" ] || continue
  [ "$(jq -r '.type' "$m" 2>/dev/null)" = hysteria2 ] || continue
  target=$(jq -r '.port' "$m"); range=$(jq -r '.hop // empty' "$m")
  [ -n "$range" ] || continue
  IFS='-' read -r first last <<EOF2
$range
EOF2
  for tool in iptables ip6tables; do
    if ! command -v "$tool" >/dev/null; then
      [ "$tool" != iptables ] || { echo 'meruru: 缺少 iptables，无法恢复 IPv4 跳跃规则' >&2; failed=1; }
      continue
    fi
    if ! "$tool" -w 5 -t nat -C PREROUTING -p udp --dport "$first:$last" -j REDIRECT --to-ports "$target" 2>/dev/null; then
      if ! "$tool" -w 5 -t nat -A PREROUTING -p udp --dport "$first:$last" -j REDIRECT --to-ports "$target"; then
        echo "meruru: $tool 无法设置跳跃规则 $first-$last -> $target" >&2
        [ "$tool" != iptables ] || failed=1
      fi
    fi
  done
done
exit "$failed"
EOF
  chmod 700 "$HOP"
}
write_base() {
  mkdir -p "$CONF" "$META" "$MERURU_HOME/bin" "$MERURU_HOME/certs"
  [ -f "$MAIN" ] || cat >"$MAIN" <<'EOF'
{
  "log":{"level":"warn","timestamp":true},
  "outbounds":[{"type":"direct","tag":"direct"}],
  "route":{"auto_detect_interface":true,"rules":[{"ip_is_private":true,"outbound":"direct"}],"final":"direct"}
}
EOF
  write_hop_script || return 1
  cat >"$SERVICE" <<EOF
[Unit]
Description=MERURU standalone sing-box
After=network-online.target
Wants=network-online.target
[Service]
Type=simple
ExecStart=$MERURU_BIN run -c $MAIN -C $CONF
ExecStartPost=/bin/bash $HOP
Restart=on-failure
RestartSec=3
LimitNOFILE=1048576
[Install]
WantedBy=multi-user.target
EOF
  systemctl daemon-reload; systemctl enable meruru.service >/dev/null 2>&1
}

check_commit() { # node file is already staged; delete it if merged config is invalid
  local f=$1 err n m active=0 ws=0
  n=$(basename "$f" .json); m="$META/$n.meta"
  systemctl is-active --quiet meruru.service && active=1
  err=$(mktemp)
  if ! { check_node_pair "$n" && "$MERURU_BIN" check -c "$MAIN" -C "$CONF"; } 2>"$err"; then
    echo -e "${RED}sing-box validation failed; change rolled back:${OFF}"; cat "$err"; rm -f "$f" "$err" "$m" "$MERURU_HOME/certs/$n.crt" "$MERURU_HOME/certs/$n.key"; return 1
  fi
  rm -f "$err"
  [ "$(jq -r .type "$m")" != vless-ws ] || ws=1
  if ! restart || ! network_open "$m" || { [ "$ws" = 1 ] && ! caddy_ws_sync; }; then
    network_remove_delta "$m" /dev/null || true
    rm -f "$f" "$m" "$MERURU_HOME/certs/$n.crt" "$MERURU_HOME/certs/$n.key"
    [ "$ws" = 0 ] || caddy_ws_sync || true
    if [ "$active" = 1 ]; then restart; else systemctl stop meruru.service; fi
    die '创建失败；已移除新节点并恢复原运行状态。'; return 1
  fi
  echo -e "${GRN}Saved and started.${OFF}"
}
check_node_pair() { # A syntax-valid config is not enough: the share metadata must describe that config.
  local n=$1
  jq -e -s '
    length==2 and (.[0].inbounds|length)==1 and
    (.[0].inbounds[0] as $i | .[1] as $m |
      ($m.port|type)=="number" and $i.listen_port==$m.port and
      ($i.type==(if $m.type=="vless-ws" then "vless" else $m.type end)) and
      (if $m.type=="vless" or $m.type=="vless-ws" then $i.users[0].uuid==$m.uuid and ($m.uuid|type)=="string"
       elif $m.type=="tuic" then $i.users[0].uuid==$m.uuid and $i.users[0].password==$m.password
       elif $m.type=="shadowsocks" then $i.password==$m.password
       elif $m.type=="direct" then $i.override_address==$m.host and $i.override_port==$m.target_port
       elif $m.type=="anytls" or $m.type=="hysteria2" or $m.type=="trojan" then $i.users[0].password==$m.password
       else false end) and
      (if $m.type=="vless" or $m.type=="anytls" then $i.tls.server_name==$m.domain and $i.tls.reality.handshake.server==$m.domain and $i.tls.reality.short_id[0]==$m.sid
       elif $m.type=="vless-ws" then $i.transport.path==$m.path else true end))
  ' "$CONF/$n.json" "$META/$n.meta" >/dev/null || { die '节点配置与分享信息不一致或未完整写入。'; return 1; }
}
network_open() {
  local m=$1 t p h
  [ -s "$m" ] || return 0
  t=$(jq -r .type "$m"); p=$(jq -r .port "$m"); h=$(jq -r '.hop//empty' "$m")
  case "$t" in vless-ws) return 0;;hysteria2|tuic) firewall_open udp "$p" || return 1;;shadowsocks|direct) firewall_open tcp "$p" && firewall_open udp "$p" || return 1;;*)firewall_open tcp "$p" || return 1;;esac
  [ -z "$h" ] || { firewall_open udp "$h" && bash "$HOP"; } || return 1
  return 0
}
network_remove_delta() { # Remove only resources present in old and absent in new.
  local old=$1 new=$2 t p h np nh
  [ -s "$old" ] || return 0
  t=$(jq -r .type "$old"); p=$(jq -r .port "$old"); h=$(jq -r '.hop//empty' "$old")
  np=$(jq -r '.port//empty' "$new" 2>/dev/null); nh=$(jq -r '.hop//empty' "$new" 2>/dev/null)
  if [ -n "$h" ] && { [ "$h" != "$nh" ] || [ "$p" != "$np" ]; }; then
    hop_remove "$h" "$p" || return 1
    [ "$h" = "$nh" ] || firewall_close udp "$h" || return 1
  fi
  [ "$p" != "$np" ] || return 0
  case "$t" in vless-ws) :;;hysteria2|tuic)firewall_close udp "$p";;shadowsocks|direct)firewall_close tcp "$p" && firewall_close udp "$p";;*)firewall_close tcp "$p";;esac
}

firewall_open() {
  local proto=$1 p=$2 ufwp=${2//-/:} ledger="$MERURU_HOME/firewall-owned.tsv" added mode backend rc result
  if command -v ufw >/dev/null && ufw status 2>/dev/null | grep -q 'Status: active'; then
    added=$(ufw show added) || return 1
    if ! printf '%s\n' "$added" | tr -d "'" | grep -Eq "^ufw allow $ufwp/$proto([[:space:]]|$)"; then
      result=$(LC_ALL=C ufw allow "$ufwp/$proto" comment meruru 2>&1) || { printf '%s\n' "$result" >&2; return 1; }
      printf '%s\n' "$result"
      # UFW can recognise an equivalent user rule written in another syntax.
      # If either address family was skipped, conservatively avoid claiming that rule.
      if ! grep -qi 'Skipping adding existing rule' <<<"$result"; then
        printf 'ufw\t%s\t%s\n' "$proto" "$p" >>"$ledger" || return 1
      else
        echo '  UFW 已有等价规则；为保留管理员原有规则，本次不将其标记为可自动删除。'
      fi
    fi
  fi
  if command -v firewall-cmd >/dev/null && firewall-cmd --state >/dev/null 2>&1; then
    # Never reload firewalld here: reload can flush the independent Hy2 NAT rules
    # and unrelated runtime-only rules. Apply both states explicitly, with separate ownership.
    for mode in permanent runtime; do
      local -a flags=(); [ "$mode" != permanent ] || flags+=(--permanent)
      if firewall-cmd "${flags[@]}" --query-port="$p/$proto" >/dev/null 2>&1; then continue; else rc=$?; fi
      [ "$rc" = 1 ] || { die "firewalld 查询失败（$rc），未修改 $p/$proto。"; return 1; }
      firewall-cmd "${flags[@]}" --add-port="$p/$proto" || return 1
      backend="firewalld-$mode"
      printf '%s\t%s\t%s\n' "$backend" "$proto" "$p" >>"$ledger" || return 1
    done
  fi
  return 0
}
firewall_close() {
  local proto=$1 p=$2 ufwp=${2//-/:} ledger="$MERURU_HOME/firewall-owned.tsv" backend
  [ -f "$ledger" ] || return 0
  for backend in ufw firewalld firewalld-permanent firewalld-runtime; do
    grep -Fqx "$backend"$'\t'"$proto"$'\t'"$p" "$ledger" || continue
    case "$backend" in
      ufw) command -v ufw >/dev/null && ufw delete allow "$ufwp/$proto" || return 1;;
      firewalld) firewall-cmd --permanent --remove-port="$p/$proto" && firewall-cmd --remove-port="$p/$proto" || return 1;;
      firewalld-permanent) firewall-cmd --permanent --remove-port="$p/$proto" || return 1;;
      firewalld-runtime) firewall-cmd --remove-port="$p/$proto" || return 1;;
    esac
    awk -F'\t' -v b="$backend" -v p="$p" -v n="$proto" '!($1==b && $2==n && $3==p)' "$ledger" >"$ledger.tmp" && mv "$ledger.tmp" "$ledger" || return 1
  done
  return 0
}
random_free_port() {
  local candidate tries=0
  while [ "$tries" -lt 80 ]; do
    candidate=$(shuf -i 15000-55000 -n 1) || return 1; tries=$((tries+1))
    port_busy "$candidate" || { printf '%s' "$candidate"; return 0; }
  done
  return 1
}
hop_range_free() { # $1 first port, $2 last port: avoid all existing listeners and Hy2 hop ranges.
  local first=$1 last=$2 owner=${3:-} m p h hs he
  # Extract listener ports separately (ss columns contain addresses, not numbers).
  while IFS= read -r p; do
    [ "$p" -lt "$first" ] || [ "$p" -gt "$last" ] || return 1
  done < <({ ss -H -ltn; ss -H -lun; } 2>/dev/null | awk '{n=split($4,a,":");if(a[n]~/^[0-9]+$/)print a[n]}')
  for m in "$META"/*.meta; do
    [ -f "$m" ] || continue
    [ "$m" != "$META/$owner.meta" ] || continue
    p=$(jq -r '.port // 0' "$m")
    [ "$p" -ge "$first" ] && [ "$p" -le "$last" ] && return 1
    h=$(jq -r '.hop // empty' "$m"); [ -n "$h" ] || continue; IFS=- read -r hs he <<<"$h"
    [ "$first" -le "$he" ] && [ "$last" -ge "$hs" ] && return 1
  done
  return 0
}
valid_hop_range() {
  local h=$1 base=$2 owner=${3:-} first last
  [ -n "$h" ] || return 0
  [[ "$h" =~ ^[0-9]{1,5}-[0-9]{1,5}$ ]] || return 1
  IFS=- read -r first last <<<"$h"
  first=$((10#$first)); last=$((10#$last))
  port "$first" && port "$last" && [ "$first" -le "$last" ] && { [ "$base" -lt "$first" ] || [ "$base" -gt "$last" ]; } && hop_range_free "$first" "$last" "$owner"
}
random_hop_range() { # A range contains exactly ten UDP ports, inclusive.
  local first last base=${1:-0} tries=0
  while [ "$tries" -lt 80 ]; do
    first=$(shuf -i 20000-59990 -n 1) || return 1; last=$((first + 9)); tries=$((tries+1))
    [ "$base" -lt "$first" ] || [ "$base" -gt "$last" ] || continue
    hop_range_free "$first" "$last" && { printf '%s-%s' "$first" "$last"; return 0; }
  done
  return 1
}
ask_common() {
  local suggested_name suggested_port
  suggested_name="node-$(openssl rand -hex 3)"; suggested_port=$(random_free_port) || { die '无法自动选择空闲端口。'; return 1; }
  read -r -p "节点名称 [${suggested_name}]：" NAME || return 1; NAME=${NAME:-$suggested_name}; safe_name "$NAME" || return 1
  [ ! -e "$CONF/$NAME.json" ] && [ ! -e "$META/$NAME.meta" ] && [ ! -e "$MERURU_HOME/certs/$NAME.key" ] && [ ! -e "$MERURU_HOME/certs/$NAME.crt" ] || return 1
  read -r -p "监听端口 [${suggested_port}]：" PORT || return 1; PORT=${PORT:-$suggested_port}; port "$PORT" && ! port_busy "$PORT" || return 1
}
reality_tls() { # private TLS object carries _public only until it is written to a config

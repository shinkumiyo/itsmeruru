      if ($rtt|length)>0 then .rtt_min=([.rtt_min,($rtt|tonumber)]|map(select(.!=null))|min) |
        .rtt_max=([.rtt_max,($rtt|tonumber)]|map(select(.!=null))|max) else . end)' "$db" >"$tmp" && mv "$tmp" "$db"

shortcut_valid() { [[ "$1" =~ ^[A-Za-z][A-Za-z0-9_-]{0,23}$ ]]; }
shortcut_name() {
  local n; n=$(cat "$MERURU_HOME/shortcut" 2>/dev/null || true)
  shortcut_valid "$n" && printf '%s' "$n" || printf M
}
shortcut_variants() { printf '%s\n' "$1" "${1,,}" "${1^^}" | sort -u; }
shortcut_owned() {
  local path=$1
  [ "$(readlink -f "$path" 2>/dev/null)" = "$(readlink -f "$MERURU_HOME/bin/manager")" ] && return 0
  [ "$(readlink -f "$path" 2>/dev/null)" = "$LEGACY_HOME/bin/manager" ] && return 0
  # Recognise only the previous fixed-name manager entries during migration.
  case "$path" in "$COMMAND_DIR/M"|"$COMMAND_DIR/m"|"$COMMAND_DIR/sbx") [ -f "$path" ] && grep -Eq '^# (sbx|meruru) - self-contained sing-box manager' "$path";;*) return 1;;esac
}
remove_shortcuts() {
  local n
  while IFS= read -r n; do
    shortcut_owned "$COMMAND_DIR/$n" && rm -f "$COMMAND_DIR/$n"
  done < <(shortcut_variants "$(shortcut_name)")
  shortcut_owned "$COMMAND_DIR/meruru" && rm -f "$COMMAND_DIR/meruru"
  return 0
}
set_shortcut() {
  local name=$1 old n found target="$MERURU_HOME/bin/manager"
  shortcut_valid "$name" || { die '命令需以英文字母开头，最多 24 位，可包含数字、下划线和连字符。'; return 1; }
  old=$(shortcut_name)
  while IFS= read -r n; do
    found=$(command -v "$n" 2>/dev/null || true)
    if { [ -e "$COMMAND_DIR/$n" ] || [ -L "$COMMAND_DIR/$n" ]; } && ! shortcut_owned "$COMMAND_DIR/$n"; then
      die "命令 $n 已被其他文件占用，请换一个名称。"; return 1
    fi
    if [ -n "$found" ] && ! shortcut_owned "$found"; then
      die "命令 $n 已存在：$found；请换一个名称。"; return 1
    fi
  done < <(shortcut_variants "$name")
  [ -x "$target" ] || { die '管理脚本尚未安装。'; return 1; }
  while IFS= read -r n; do
    ln -sfnT "$target" "$COMMAND_DIR/$n" || { die '快捷命令创建失败，原快捷命令保留。'; return 1; }
  done < <(shortcut_variants "$name")
  printf '%s\n' "$name" >"$MERURU_HOME/shortcut" || return 1
  while IFS= read -r n; do
    case "$n" in meruru|"$name"|"${name,,}"|"${name^^}") continue;;esac
    shortcut_owned "$COMMAND_DIR/$n" && rm -f "$COMMAND_DIR/$n"
  done < <(shortcut_variants "$old")
  hash -r
  return 0
}

sni_dns_cdn_check() { # A brand-owned hostname is not evidence of brand-owned delivery.
  local d=$1 ip=$2 chain row data next count=0
  chain=$d
  while [ "$count" -lt 8 ]; do
    count=$((count+1)); next=
    if command -v dig >/dev/null 2>&1; then
      row=$(dig +time=2 +tries=1 +noall +answer "$chain" CNAME 2>/dev/null) || return 2
      next=$(awk '$4=="CNAME" {print $5;exit}' <<<"$row")
    else
      data=$(curl -fsS --connect-timeout 2 --max-time 4 -G 'https://dns.google/resolve' --data-urlencode "name=$chain" --data-urlencode 'type=CNAME' 2>/dev/null) || return 2
      jq -e '.Status==0' <<<"$data" >/dev/null 2>&1 || return 2
      next=$(jq -r '[.Answer[]? | select(.type==5) | .data][0] // empty' <<<"$data")
    fi
    [ -n "$next" ] || return 0
    next=${next,,}; next=${next%.}
    if [[ "$next" =~ (^|\.)(cloudflare\.net|cloudflare\.com|cloudflare-dns\.com|akamaiedge\.net|akamaized\.net|akamai\.net|akamaitechnologies\.com|edgesuite\.net|edgekey\.net|akadns\.net|cloudfront\.net|awsglobalaccelerator\.com|fastly\.net|fastlylb\.net|map\.fastly\.net|cdn77\.org|cdn77\.net|b-cdn\.net|bunnycdn\.com|stackpathdns\.com|stackpathcdn\.com|hwcdn\.net|llnwd\.net|edgecastcdn\.net|cdn\.arvancloud\.ir)$ ]]; then
      echo "  第三方 CDN DNS 特征：$next"; return 1
    fi
    if [[ "$next" =~ (^|\.)(azureedge\.net|azurefd\.net)$ ]] && [[ ! "$d" =~ (^|\.)(microsoft\.com|office\.com|bing\.com|xbox\.com|surface\.com)$ ]]; then
      echo "  第三方 Microsoft CDN DNS 特征：$next"; return 1
    fi
    chain=$next
  done
  return 2
}
test_sni() { # Three TCP samples (median) gate first, then strict TLS/HTTP screening.
  local d=$1 official_pool=${2:-} hdr tls cert ms sample start_ns end_ns ip tls13 h2 x25519 san; local -a samples=()
  SNI_LAST_RTT=; SNI_LAST_IP=; [[ "$d" =~ ^[A-Za-z0-9.-]+$ ]] || return 1
  ip=$(getent ahostsv4 "$d" 2>/dev/null | awk 'NR==1{print $1}'); [ -n "$ip" ] || { echo '  DNS 解析失败'; return 1; }
  hdr=$(mktemp); tls=$(mktemp); cert=$(mktemp)
  # Three fast TCP handshakes give a stable median while still rejecting slow sites before costly TLS work.
  for sample in 1 2 3; do
    start_ns=$(date +%s%N); timeout 2 bash -c "exec 3<>/dev/tcp/$ip/443" 2>/dev/null || { rm -f "$hdr" "$tls" "$cert"; echo "  TCP 443 第 ${sample} 次连接失败"; return 1; }; end_ns=$(date +%s%N)
    samples+=("$(awk -v s="$start_ns" -v e="$end_ns" 'BEGIN {printf "%.3f", (e-s)/1000000}')")
  done
  ms=$(printf '%s\n' "${samples[@]}" | sort -n | sed -n '2p')
  SNI_LAST_RTT=$ms; SNI_LAST_IP=$ip
  if awk -v rtt="$ms" -v limit="$SNI_MAX_RTT_MS" 'BEGIN {exit !(rtt > limit)}'; then rm -f "$hdr" "$tls" "$cert"; echo "  TCP RTT 中位数 ${ms} ms（${samples[*]}），超过阈值 ${SNI_MAX_RTT_MS} ms，已提前淘汰"; return 4; fi
  # Check DNS as well as response headers: third-party CDNs can hide Server headers.
  local dns_rc
  sni_dns_cdn_check "$d" "$ip"; dns_rc=$?
  if [ "$dns_rc" -ne 0 ]; then
    rm -f "$hdr" "$tls" "$cert"
    [ "$dns_rc" = 1 ] && return 2
    echo '  CDN DNS 检查不可用，暂不入库（安装 dig 可使用本机 DNS 检查）'; return 6
  fi
  # Pin HTTP and OpenSSL verification to the same resolved IPv4; do not follow redirects to another host.
  curl -4 -fsSI --http2 --tlsv1.3 --resolve "$d:443:$ip" --connect-timeout 2 --max-time 6 "https://$d/" >"$hdr" 2>/dev/null || { rm -f "$hdr" "$tls" "$cert"; echo '  HTTPS / HTTP2 连接失败'; return 1; }
  # Use the identical IPv4 that curl tested.  Do not let OpenSSL silently prefer a broken IPv6 route.
  if ! timeout 10 openssl s_client -connect "$ip:443" -servername "$d" -alpn h2 -tls1_3 -groups X25519 -verify_hostname "$d" -verify_return_error </dev/null >"$tls" 2>&1; then
    rm -f "$hdr" "$tls" "$cert"; echo '  TLS 1.3 / X25519 握手或证书链验证失败'; return 3
  fi
  if grep -Eqi '^(server: *(cloudflare|akamaighost|bunnycdn|cdn77)|cf-ray:|x-amz-cf-id:|x-amz-cf-pop:|x-cache:.*cloudfront|x-served-by:.*fastly|via:.*cloudfront)' "$hdr"; then
    rm -f "$hdr" "$tls" "$cert"; echo '  检测到第三方 CDN 响应特征'; return 2
  fi
  grep -Eqi 'TLSv1\.3' "$tls" && tls13=是 || tls13=否
  grep -Eqi 'ALPN protocol: h2' "$tls" && h2=是 || h2=否
  # Force the ordinary X25519 group, rather than inferring it from a hybrid negotiation.
  grep -Eqi '(Server Temp Key:.*X25519|Peer Temp Key:.*X25519)' "$tls" && x25519=是 || x25519=否
  sed -n '/-----BEGIN CERTIFICATE-----/,/-----END CERTIFICATE-----/p' "$tls" >"$cert"
  openssl x509 -in "$cert" -noout -checkhost "$d" 2>/dev/null | grep -qi 'does match' && san=是 || san=否
  [ "$tls13" = 是 ] && [ "$h2" = 是 ] && [ "$x25519" = 是 ] && [ "$san" = 是 ] || { local diag; diag=$(grep -Ei '(Protocol|ALPN|Temp Key|X25519)' "$tls" | tr '\n' ';' | head -c 300); rm -f "$hdr" "$tls" "$cert"; echo "  条件未全满足：TLS1.3=$tls13，H2=$h2，X25519=$x25519，证书SAN=$san；握手：${diag:-无可读字段}"; return 3; }
  rm -f "$hdr" "$tls" "$cert"; echo "  通过：$d → $ip，TCP RTT 中位数 ${ms} ms（${samples[*]}），证书 SAN 覆盖=是"; return 0
}

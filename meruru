        vless|vless-ws) new=$(uuid); jq --arg v "$new" '.inbounds[0].users[0].uuid=$v' "$f" >"$f.tmp" && mv "$f.tmp" "$f"; jq --arg v "$new" '.uuid=$v' "$m" >"$m.tmp" && mv "$m.tmp" "$m";;
        tuic) new=$(uuid); target=$(openssl rand -base64 18 | tr -d '=+/\n' | head -c 18); jq --arg u "$new" --arg p "$target" '.inbounds[0].users[0].uuid=$u | .inbounds[0].users[0].password=$p' "$f" >"$f.tmp" && mv "$f.tmp" "$f"; jq --arg u "$new" --arg p "$target" '.uuid=$u | .password=$p' "$m" >"$m.tmp" && mv "$m.tmp" "$m";;
        shadowsocks) new=$(openssl rand -base64 16 | tr -d '\n'); jq --arg p "$new" '.inbounds[0].password=$p' "$f" >"$f.tmp" && mv "$f.tmp" "$f"; jq --arg p "$new" '.password=$p' "$m" >"$m.tmp" && mv "$m.tmp" "$m";;
        anytls|hysteria2|trojan) new=$(openssl rand -base64 24 | tr -d '=+/\n' | head -c 24); jq --arg p "$new" '.inbounds[0].users[0].password=$p' "$f" >"$f.tmp" && mv "$f.tmp" "$f"; jq --arg p "$new" '.password=$p' "$m" >"$m.tmp" && mv "$m.tmp" "$m";;
        *) transaction_end; die 'Direct Tunnel 没有凭据可更改。'; return;; esac
      update_transaction "$n" && show_node "$n";;
   3) if [ "$type" = hysteria2 ]; then
        read -r -p '新范围（如 20000-20009，留空关闭）：' hop
        valid_hop_range "$hop" "$old" "$n" || { transaction_end; die '范围无效、重叠或与监听端口冲突。'; return 1; }

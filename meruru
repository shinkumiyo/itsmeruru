delete_nodes_transaction() {
  local backup n active=0 failed=0 ws=0
  backup=$(mktemp -d "$MERURU_HOME/.delete-backup.XXXXXX") || return 1
  mkdir -p "$backup/conf" "$backup/meta" "$backup/certs" || return 1
  for n in "$@"; do
    safe_name "$n" && cp -p "$CONF/$n.json" "$backup/conf/" && cp -p "$META/$n.meta" "$backup/meta/" || { rm -rf "$backup"; die '无法备份节点，未删除。'; return 1; }
    [ "$(jq -r .type "$META/$n.meta")" != vless-ws ] || ws=1
    local cert
    for cert in "$MERURU_HOME/certs/$n.crt" "$MERURU_HOME/certs/$n.key"; do
      [ ! -f "$cert" ] || cp -p "$cert" "$backup/certs/" || { die '无法备份证书，未删除。'; return 1; }
    done
  done
  systemctl is-active --quiet meruru.service && active=1
  for n in "$@"; do rm -f "$CONF/$n.json" "$META/$n.meta"; done
  "$MERURU_BIN" check -c "$MAIN" -C "$CONF" || failed=1
  if [ "$failed" = 0 ]; then [ "$active" = 0 ] || restart || failed=1; fi
  if [ "$failed" = 0 ] && [ "$ws" = 1 ]; then caddy_ws_sync || failed=1; fi
  if [ "$failed" = 0 ]; then
    for n in "$@"; do network_remove_delta "$backup/meta/$n.meta" /dev/null || { failed=1; break; }; done
  fi
  if [ "$failed" = 1 ]; then
    for n in "$@"; do cp -p "$backup/conf/$n.json" "$CONF/"; cp -p "$backup/meta/$n.meta" "$META/"; network_open "$META/$n.meta"; done
    [ "$ws" = 0 ] || caddy_ws_sync
    [ "$active" = 0 ] || restart
    die "删除未完成，已恢复原节点；备份：$backup"; return 1
  fi
  for n in "$@"; do rm -f "$MERURU_HOME/certs/$n.crt" "$MERURU_HOME/certs/$n.key"; done
  RECOVERY_MODE=0
  # Keep the configuration backup private and available for manual recovery.
  echo "  删除前配置备份：$backup"
}
hop_remove() {
  local hop=$1 target=$2 range t rc failed=0; range=${hop/-/:}
  for t in iptables ip6tables; do
    command -v "$t" >/dev/null || continue
    while :; do
      if "$t" -w 5 -t nat -C PREROUTING -p udp --dport "$range" -j REDIRECT --to-ports "$target" 2>/dev/null; then
        if ! "$t" -w 5 -t nat -D PREROUTING -p udp --dport "$range" -j REDIRECT --to-ports "$target"; then
          die "$t 删除跳跃规则 $hop → $target 失败。"; failed=1; break
        fi
      else
        rc=$?
        if [ "$rc" != 1 ] && [ "$t" = iptables ]; then die "iptables 查询规则失败（$rc），未确认 NAT 已清理。"; failed=1; fi
        break
      fi
    done
  done
  return "$failed"
}
port_busy() { # $1 port, $2 optional node name whose currently bound port is permitted
  local p=$1 owner=${2:-} ownp='' m h first last mp
  [ -n "$owner" ] && [ -f "$META/$owner.meta" ] && ownp=$(jq -r '.port' "$META/$owner.meta")
  [ "$p" = "$ownp" ] && return 1
  for m in "$META"/*.meta; do
    [ -f "$m" ] || continue
    mp=$(jq -r '.port//0' "$m")
    if [ "$m" != "$META/$owner.meta" ] && [ "$mp" = "$p" ]; then return 0; fi
    h=$(jq -r '.hop//empty' "$m"); [ -n "$h" ] || continue
    IFS=- read -r first last <<<"$h"
    [[ "$first" =~ ^[0-9]+$ && "$last" =~ ^[0-9]+$ ]] || continue
    [ "$p" -lt "$first" ] || [ "$p" -gt "$last" ] || return 0
  done
  ss -H -ltn 2>/dev/null | awk '{print $4}' | grep -Eq "[:.]$p$|\]:$p$" || ss -H -lun 2>/dev/null | awk '{print $4}' | grep -Eq "[:.]$p$|\]:$p$"
}
transaction_begin() {
  TX_NODE=$1; TX_CONF=$(mktemp) && TX_META=$(mktemp) && cp "$CONF/$1.json" "$TX_CONF" && cp "$META/$1.meta" "$TX_META" || { transaction_end; return 1; }
}
transaction_end() { rm -f "${TX_CONF:-}" "${TX_META:-}"; unset TX_NODE TX_CONF TX_META; }
update_transaction() { # transaction_begin MUST be called before the caller edits either file
  local n=$1 f="$CONF/$1.json" m="$META/$1.meta" active=0 failed=0 candidate
  [ "${TX_NODE:-}" = "$n" ] && [ -f "${TX_CONF:-}" ] && [ -f "${TX_META:-}" ] || { die '内部事务备份缺失，拒绝保存。'; return 1; }
  if ! check_node_pair "$n" || ! "$MERURU_BIN" check -c "$MAIN" -C "$CONF"; then cp "$TX_CONF" "$f"; cp "$TX_META" "$m"; transaction_end; die '校验失败，已恢复原节点。'; return 1; fi
  systemctl is-active --quiet meruru.service && active=1
  [ "$active" = 0 ] || restart || failed=1
  network_open "$m" || failed=1
  if [ "$(jq -r .type "$m")" = vless-ws ]; then caddy_ws_sync || failed=1; fi
  if [ "$failed" = 0 ]; then network_remove_delta "$TX_META" "$m" || failed=1; fi
  if [ "$failed" = 1 ]; then
    candidate=$(mktemp); cp "$m" "$candidate"
    cp "$TX_CONF" "$f"; cp "$TX_META" "$m"
    network_open "$m"; network_remove_delta "$candidate" "$m"; rm -f "$candidate"
    [ "$(jq -r .type "$m")" != vless-ws ] || caddy_ws_sync
    [ "$active" = 0 ] || restart
    transaction_end; die '更新失败，已恢复节点及相关资源。'; return 1
  fi
  transaction_end; echo -e "${GRN}节点已更新；原先停止的服务保持停止。${OFF}"
}
change_node() {
  local n type f m old new hop target target_port
  node_picker || return; n=$NODE_SELECTED; f="$CONF/$n.json"; m="$META/$n.meta"; [ -f "$f" ] && [ -f "$m" ] || { die '节点不存在。'; return; }
  type=$(jq -r .type "$m"); old=$(jq -r .port "$m")
  transaction_begin "$n" || { die '无法创建事务备份。'; return; }
  ui_title '修改节点'; ui_item 1 '修改监听端口'; ui_item 2 '重新生成凭据（UUID / 密码）'
  [ "$type" = hysteria2 ] && ui_item 3 '修改 Hy2 跳跃端口范围'
  [ "$type" = direct ] && ui_item 3 '修改一键落地目标'
  case "$type" in vless|anytls) ui_item 3 '修改 SNI（选择后自动复测）';; esac
  [ "$type" != vless-ws ] || { echo '  此处修改本机后端端口；客户端 TLS 入口始终为 443。'; ui_item 3 '重新生成 WebSocket 路径'; }

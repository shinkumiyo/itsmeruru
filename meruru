sni_revalidate() { # Build a fresh database: failures disappear, successes retain their class/purpose and fresh RTT.
  local db="$MERURU_HOME/sni-candidates.tsv" bak="$MERURU_HOME/sni-candidates.previous.tsv" d category source purpose ip rtt verified

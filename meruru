delete_node() {
  local choice confirm n
  ui_title '删除节点'; ui_item 1 '删除单个节点'; ui_item 2 '删除全部节点'; ui_rule; read -r -p '  选择：' choice || return 0
  case "$choice" in
    1) node_picker || return; n=$NODE_SELECTED
       read -r -p "确认删除节点 $(jq -r .name "$META/$n.meta")？[y/N] " confirm; [[ "$confirm" =~ ^[Yy]$ ]] || return
       delete_nodes_transaction "$n" && echo '节点已删除。';;
    2) [ -n "$(find "$META" -maxdepth 1 -type f -name '*.meta' -print -quit 2>/dev/null)" ] || { echo '暂无节点。'; return; }
       read -r -p '确认删除全部节点？[y/N] ' confirm; [[ "$confirm" =~ ^[Yy]$ ]] || return
       local -a selected=()
       for n in "$META"/*.meta; do [ -f "$n" ] && selected+=("$(basename "${n%.meta}")"); done
       delete_nodes_transaction "${selected[@]}" && echo '全部节点已删除。';;
  esac

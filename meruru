</main><footer><span>微光 · 把心愿留给明天</span><span class="quiet">愿每一个普通的日子，都有回响。</span></footer>
<script>
(()=>{'use strict';
const key='small-light-wishes-v1',wall=document.getElementById('wall'),input=document.getElementById('message'),status=document.getElementById('status');
const curated=[['日常','愿你有按时吃饭的从容，也有偶尔绕远路看夕阳的心情。'],['重逢','希望下一次说「好久不见」的时候，我们都有好多好消息。'],['勇气','愿那些还没说出口的期待，终于有一天，被你认真对待。'],['生长','慢一点也没关系。树有树的年轮，花有花的时节。'],['远方','愿行李里装着想去的远方，心里始终有可以回来的地方。'],['此刻','愿今晚的你，能把今天暂时放下，好好睡一觉。']];
let mine=[],filter='all',memoryOnly=false;
try{const saved=JSON.parse(localStorage.getItem(key)||'[]');if(Array.isArray(saved))mine=saved.filter(x=>x&&typeof x.text==='string'&&typeof x.id==='string').slice(0,60).map(x=>({id:x.id,text:x.text.slice(0,160),date:typeof x.date==='string'?x.date.slice(0,32):''}));}catch(_){memoryOnly=true;status.textContent='浏览器存储不可用，本次心愿仅临时保留。';}
function save(){try{localStorage.setItem(key,JSON.stringify(mine));memoryOnly=false;}catch(_){memoryOnly=true;}}
function render(){wall.replaceChildren();const rows=mine.map(x=>({...x,own:true,tag:'我的心愿'}));if(filter==='all')curated.forEach((x,i)=>rows.push({id:'curated-'+i,tag:x[0],text:x[1],date:'精选寄语'}));document.getElementById('empty').hidden=rows.length>0;rows.forEach(row=>{const card=document.createElement('article');card.className='card';const top=document.createElement('div');top.className='card-top';top.textContent=row.tag+'　✧';const text=document.createElement('p');text.textContent=row.text;const bottom=document.createElement('div');bottom.className='card-bottom';const label=document.createElement('span');label.textContent=row.date;bottom.append(label);if(row.own){const button=document.createElement('button');button.type='button';button.className='remove';button.textContent='收起这份心愿 ×';button.addEventListener('click',()=>{mine=mine.filter(x=>x.id!==row.id);save();render();status.textContent=memoryOnly?'已移除；浏览器存储不可用，刷新后旧记录可能恢复。':'已移除这份心愿。';});bottom.append(button);}card.append(top,text,bottom);wall.append(card);});}
input.addEventListener('input',()=>{document.getElementById('counter').textContent=input.value.length+' / 160';});
document.querySelectorAll('[data-filter]').forEach(button=>button.addEventListener('click',()=>{filter=button.dataset.filter;document.querySelectorAll('[data-filter]').forEach(b=>b.setAttribute('aria-pressed',String(b===button)));render();}));
document.getElementById('wish-form').addEventListener('submit',event=>{event.preventDefault();const text=input.value.trim();if(!text){status.textContent='先写下一点期待吧。';input.focus();return;}if(mine.length>=60){status.textContent='已保存 60 份心愿，可以先收起一些旧便笺。';return;}mine.unshift({id:Date.now().toString(36)+'-'+Math.random().toString(36).slice(2),text:text.slice(0,160),date:new Date().toLocaleDateString('zh-CN')});save();render();input.value='';document.getElementById('counter').textContent='0 / 160';status.textContent=memoryOnly?'心愿已临时留下；浏览器存储不可用，关闭页面后可能消失。':'心愿已留下。愿好事慢慢发生。';});
render();})();
</script></body></html>

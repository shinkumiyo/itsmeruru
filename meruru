  read -r -p '  新命令（回车取消）：' n; [ -n "$n" ] || return 0
  set_shortcut "$n" && echo "  已修改：$n / ${n,,} / ${n^^}。退出后即可使用。"
}
install_manager() {
  local source=${BASH_SOURCE[0]} target="$MERURU_HOME/bin/manager"
  [ -f "$source" ] && [ -r "$source" ] || return 0
  if [ "$(readlink -f "$source")" != "$(readlink -f "$target")" ]; then
    bash -n "$source" || return 1
    if [ -f "$target" ] && [ "$(sha256sum "$source" | awk '{print $1}')" != "$(sha256sum "$target" | awk '{print $1}')" ]; then
      cp -p "$target" "$target.previous" || return 1
    fi
    bash -n "$source" && install -D -m 755 "$source" "$target" || { die '管理命令安装失败。'; return 1; }
  fi
  if { [ -e "$COMMAND_DIR/meruru" ] || [ -L "$COMMAND_DIR/meruru" ]; } && ! shortcut_owned "$COMMAND_DIR/meruru"; then
    die 'meruru 命令已被其他文件占用。'; return 1
  fi
  ln -sfnT "$target" "$COMMAND_DIR/meruru" || return 1
  set_shortcut "$(shortcut_name)" || return 1
  if shortcut_owned "$COMMAND_DIR/sbx"; then rm -f "$COMMAND_DIR/sbx"; fi
  install_recovery_launcher
}
install_recovery_launcher() {
  local launcher="$COMMAND_DIR/meruru-rollback"
  if [ -e "$launcher" ] && ! grep -Fq '# meruru independent recovery' "$launcher"; then
    echo '  meruru-rollback 名称已被占用，独立恢复入口未安装。'; return 0
  fi
  {
    printf '#!/usr/bin/env bash\n# meruru independent recovery\nset -u\numask 077\n'
    printf 'target=%q\n' "$MERURU_HOME/bin/manager"
    cat <<'RECOVERY'
[ "$(id -u)" = 0 ] || { echo '请使用 root 执行。' >&2; exit 1; }
mkdir -p /run/meruru && chmod 700 /run/meruru || exit 1
exec 9>/run/meruru/manager.lock
flock -n 9 || { echo '请先退出正在运行的面板。' >&2; exit 1; }
[ -s "$target.previous" ] && bash -n "$target.previous" || { echo '没有可用的上一版脚本。' >&2; exit 1; }
temp=$(mktemp "${target}.restore.XXXXXX") || exit 1
cp "$target.previous" "$temp" && chmod 755 "$temp" && mv -f "$temp" "$target" || { rm -f "$temp"; exit 1; }
echo '已恢复上一版管理脚本。'
exec 9>&-
exec bash "$target"
RECOVERY
  } >"$launcher" || return 1
  chmod 755 "$launcher"
}
migration_restore() { # Called only while migrate_legacy_install's local state is in scope.
  systemctl disable --now meruru.service meruru-caddy.service >/dev/null 2>&1 || true
  rm -f "$SERVICE" "$CADDY_SERVICE"
  systemctl daemon-reload
  [ "$old_enabled" != 1 ] || systemctl enable sbx.service >/dev/null 2>&1
  [ "$caddy_enabled" != 1 ] || systemctl enable sbx-caddy.service >/dev/null 2>&1
  [ "$caddy_active" != 1 ] || systemctl start sbx-caddy.service
  [ "$old_active" != 1 ] || systemctl start sbx.service
  failed="$MERURU_HOME.failed.$(date +%Y%m%d-%H%M%S)"
  [ ! -e "$failed" ] && mv "$MERURU_HOME" "$failed"
  die "迁移失败，已恢复旧服务；原数据保留在 $LEGACY_HOME，迁移副本保留在 $failed。"
  return 1
}
migrate_legacy_install() {
  local old_active=0 old_enabled=0 caddy_active=0 caddy_enabled=0 failed f backup
  [ -f "$LEGACY_HOME/config.json" ] || return 0
  if [ -f "$LEGACY_HOME/.meruru-migrated" ] || [ -d "$LEGACY_HOME/meruru-migration-backup" ]; then return 0; fi
  [ ! -f "$MAIN" ] || return 0
  [ ! -e "$MERURU_HOME" ] && [ ! -L "$MERURU_HOME" ] || { die '检测到未完成的 meruru 目录，拒绝覆盖；请先检查该目录。'; return 1; }
  [ ! -e "$SERVICE" ] && [ ! -e "$CADDY_SERVICE" ] || { die 'meruru 服务文件已存在，拒绝覆盖迁移。'; return 1; }
  ui_title '迁移旧版数据 → meruru'
  echo "  原目录 $LEGACY_HOME 将保留为备份；现有节点端口、凭据和 WS 路径不变。"
  systemctl is-active --quiet sbx.service && old_active=1
  systemctl is-enabled --quiet sbx.service && old_enabled=1
  systemctl is-active --quiet sbx-caddy.service && caddy_active=1
  systemctl is-enabled --quiet sbx-caddy.service && caddy_enabled=1
  mkdir -p "$MERURU_HOME" || return 1
  cp -a "$LEGACY_HOME/." "$MERURU_HOME/" || { migration_restore; return 1; }
  # Rebase filesystem values only; never change UUIDs, passwords, tags or WS URLs.
  for f in "$MAIN" "$CONF"/*.json "$META"/*.meta; do
    [ -f "$f" ] || continue
    jq --arg old "$LEGACY_HOME" --arg new "$MERURU_HOME" 'walk(if type=="string" then if .==$old or startswith($old+"/") then $new+.[($old|length):] else . end else . end)' "$f" >"$f.migrate" && mv "$f.migrate" "$f" || { migration_restore; return 1; }
  done
  for f in "$CADDY_DIR"/*.caddy "$CADDY_DIR/Caddyfile" "$CADDY_DIR/storage-root"; do
    [ -f "$f" ] || continue
    sed "s#$LEGACY_HOME/#$MERURU_HOME/#g" "$f" >"$f.migrate" && mv "$f.migrate" "$f" || { migration_restore; return 1; }
  done
  write_base || { migration_restore; return 1; }
  [ "$old_enabled" = 1 ] || systemctl disable meruru.service >/dev/null 2>&1
  if [ -f "$LEGACY_CADDY_SERVICE" ]; then
    sed "s#$LEGACY_HOME/#$MERURU_HOME/#g;s#sbx-caddy#meruru-caddy#g;s#SBX#MERURU#g" "$LEGACY_CADDY_SERVICE" >"$CADDY_SERVICE" || { migration_restore; return 1; }
  fi
  "$MERURU_BIN" check -c "$MAIN" -C "$CONF" || { migration_restore; return 1; }
  if [ -f "$CADDY_SERVICE" ]; then
    "$CADDY_BIN" validate --config "$CADDY_DIR/Caddyfile" --adapter caddyfile || { migration_restore; return 1; }
  fi
  systemctl daemon-reload
  if [ "$old_active" = 1 ]; then systemctl stop sbx.service || { migration_restore; return 1; }; fi
  if [ "$caddy_active" = 1 ]; then systemctl stop sbx-caddy.service || { migration_restore; return 1; }; fi
  if [ "$caddy_active" = 1 ]; then systemctl start meruru-caddy.service || { migration_restore; return 1; }; fi
  if [ "$old_active" = 1 ]; then systemctl start meruru.service || { migration_restore; return 1; }; fi
  sleep 1
  [ "$caddy_active" = 0 ] || systemctl is-active --quiet meruru-caddy.service || { migration_restore; return 1; }
  [ "$old_active" = 0 ] || systemctl is-active --quiet meruru.service || { migration_restore; return 1; }
  systemctl disable sbx.service sbx-caddy.service >/dev/null 2>&1 || true
  [ "$caddy_enabled" = 0 ] || systemctl enable meruru-caddy.service >/dev/null 2>&1
  backup="$LEGACY_HOME/meruru-migration-backup"; mkdir -p "$backup"
  [ ! -f "$LEGACY_SERVICE" ] || mv "$LEGACY_SERVICE" "$backup/sbx.service"
  [ ! -f "$LEGACY_CADDY_SERVICE" ] || mv "$LEGACY_CADDY_SERVICE" "$backup/sbx-caddy.service"
  printf '%s\n' "$(date -Is)" >"$LEGACY_HOME/.meruru-migrated"
  chmod 700 "$LEGACY_HOME"
  systemctl daemon-reload
  echo -e "${GRN}迁移完成：服务名 meruru / meruru-caddy，原始数据备份未删除。${OFF}"
}
verify_script_candidate() {
  bash -n "$1" && grep -q '^# meruru - self-contained sing-box manager' "$1" && grep -Eq '^MERURU_VERSION=[0-9A-Za-z._-]+$' "$1" || { die '下载内容不是有效的 meruru 管理脚本，未替换。'; return 1; }
  if [ "${RECOVERY_MODE:-0}" != 1 ]; then
    "$MERURU_BIN" check -c "$MAIN" -C "$CONF" || { die '现有节点配置未通过检查，先修复配置或进入恢复模式再更新。'; return 1; }
  fi
}
launch_updated_manager() { exec bash "$MERURU_HOME/bin/manager"; }
update_manager() {
  local tmp target="$MERURU_HOME/bin/manager" version remote_hash current_hash
  tmp=$(mktemp "$MERURU_HOME/bin/.manager-update.XXXXXX") || return 1
  echo '  正在从 GitHub 下载最新管理脚本 …'
  if ! curl --proto '=https' --tlsv1.2 -fL --retry 2 --connect-timeout 8 --max-time 60 "$UPDATE_URL?ts=$(date +%s)" -o "$tmp"; then
    rm -f "$tmp"; die '脚本下载失败，当前版本未改动。'; return 1
  fi
  if ! verify_script_candidate "$tmp"; then rm -f "$tmp"; return 1; fi
  remote_hash=$(sha256sum "$tmp" | awk '{print $1}'); current_hash=$(sha256sum "$target" | awk '{print $1}')
  if [ "$remote_hash" = "$current_hash" ]; then rm -f "$tmp"; echo '  当前管理脚本已是最新版。'; return 0; fi
  version=$(sed -n 's/^MERURU_VERSION=//p' "$tmp" | head -n1)
  echo "  当前 $MERURU_VERSION → 最新 $version"
  cp -p "$target" "$target.previous" && chmod 755 "$tmp" && mv -f "$tmp" "$target" || { rm -f "$tmp"; die '脚本替换失败，未进入新版本。'; return 1; }
  echo '  更新完成，自动重新进入面板；节点配置及快捷命令保留。'
  launch_updated_manager
}
rollback_manager() {
  local target="$MERURU_HOME/bin/manager" tmp
  [ -s "$target.previous" ] || { die '没有可回退的管理脚本备份。'; return 1; }
  bash -n "$target.previous" && grep -q '^# meruru - self-contained sing-box manager' "$target.previous" || { die '备份脚本校验失败。'; return 1; }
  tmp=$(mktemp "$MERURU_HOME/bin/.manager-rollback.XXXXXX") || return 1
  cp "$target.previous" "$tmp" && chmod 755 "$tmp" && mv -f "$tmp" "$target" || { rm -f "$tmp"; return 1; }
  echo '  已恢复上一版管理脚本。'; launch_updated_manager
}
restore_update_binary() {
  cp -p "$1.previous" "$1.restore" && mv -f "$1.restore" "$1" || { die "自动回退失败；旧程序备份：$1.previous"; return 1; }
  timeout 25 systemctl restart "$2" || { die '旧程序已恢复，但服务重启失败，请查看日志。'; return 1; }
}
update_binary() {
  local kind=$1 target unit tmp active=0 staged
  case "$kind" in
    core) target=$MERURU_BIN; unit=meruru.service;;
    caddy) target=$CADDY_BIN; unit=meruru-caddy.service
      [ -x "$target" ] && [ -f "$CADDY_DIR/Caddyfile" ] || { die '请先配置自有域名，Caddy 会自动安装。'; return 1; };;
    *) return 1;;
  esac
  tmp=$(mktemp -d "$MERURU_HOME/bin/.binary-update.XXXXXX") || return 1
  if [ "$kind" = core ]; then
    (MERURU_BIN="$tmp/new"; download_core) || { rm -rf "$tmp"; die '内核下载失败，原内核未替换。'; return 1; }
    "$tmp/new" check -c "$MAIN" -C "$CONF" || { rm -rf "$tmp"; die '新内核不兼容当前配置，更新取消。'; return 1; }
  else
    (CADDY_BIN="$tmp/new"; download_caddy) || { rm -rf "$tmp"; die 'Caddy 下载失败，原程序未替换。'; return 1; }
    "$tmp/new" validate --config "$CADDY_DIR/Caddyfile" --adapter caddyfile || { rm -rf "$tmp"; die '新 Caddy 未通过配置校验，更新取消。'; return 1; }
  fi
  if [ "$(sha256sum "$tmp/new" | awk '{print $1}')" = "$(sha256sum "$target" | awk '{print $1}')" ]; then
    rm -rf "$tmp"; echo '  当前程序已是最新版，无需重启。'; return 0
  fi
  systemctl is-active --quiet "$unit" && active=1
  cp -p "$target" "$target.previous" && mv -f "$tmp/new" "$target" || { rm -rf "$tmp"; die '程序替换失败。'; return 1; }
  rm -rf "$tmp"
  if [ "$active" = 1 ]; then
    if ! timeout 25 systemctl restart "$unit"; then
      restore_update_binary "$target" "$unit" || return 1
      die '新版本启动失败，已恢复旧程序。'; return 1
    fi
    sleep 1
    if ! systemctl is-active --quiet "$unit"; then
      restore_update_binary "$target" "$unit" || return 1
      die '新版本未保持运行，已恢复旧程序。'; return 1
    fi
  fi
  echo '  程序更新完成；原先停止的服务保持停止，节点数据未改动。'
}
update_menu() {
  local choice
  while :; do
    clear; ui_title '版本更新'
    echo "  当前管理脚本：$MERURU_VERSION"
    ui_item 1 '更新管理脚本    下载 / 校验 / 自动重新进入'
    ui_item 2 '更新 sing-box   官方稳定版 / 检查节点兼容性'

quarantine_config() {
  local f i choice dest base; local -a files=()
  [ "${RECOVERY_MODE:-0}" = 1 ] || return 1
  for f in "$CONF"/*.json; do [ -f "$f" ] && files+=("$f"); done
  [ "${#files[@]}" -gt 0 ] || { die '没有节点分片；请根据检查错误修复主配置，或从备份恢复。'; return 1; }
  for i in "${!files[@]}"; do ui_item "$((i+1))" "$(basename "${files[$i]}")"; done
  read -r -p '隔离编号（将停止节点服务，回车取消）：' choice || return 0
  [ -n "$choice" ] || return 0
  valid_index "$choice" "${#files[@]}" || return 1
  f=${files[$((10#$choice-1))]}; base=$(basename "$f" .json)
  dest=$(mktemp -d "$MERURU_HOME/.quarantine.XXXXXX") || return 1
  timeout 25 systemctl stop meruru.service || { die '节点服务停止失败，未隔离文件。'; return 1; }
  mv "$f" "$dest/" || return 1
  if [ -f "$META/$base.meta" ]; then
    mv "$META/$base.meta" "$dest/" || { mv "$dest/$base.json" "$CONF/"; die '元数据隔离失败，已恢复配置文件；服务保持停止。'; return 1; }
    network_remove_delta "$dest/$base.meta" /dev/null || echo "  规则清理失败，原元数据保留在 $dest，卸载时会重试。"
    [ "$(jq -r .type "$dest/$base.meta" 2>/dev/null)" != vless-ws ] || caddy_ws_sync
  fi
  echo "已隔离到 $dest，节点服务保持停止。证书保留。"
  if "$MERURU_BIN" check -c "$MAIN" -C "$CONF"; then RECOVERY_MODE=0; echo '配置恢复有效，可从运行管理启动/重启服务。'; fi
}

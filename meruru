find_caddy_certificate() {
  local cert key tries candidates storage
  TLS_CERT=; TLS_KEY=
  echo "  查找 $TLS_DOMAIN 的 Caddy 证书（最多 3 次，每次搜索限时 4 秒）…"
  for tries in 1 2 3; do
    echo "  证书检查 $tries / 3 …"
    storage=$(cat "$CADDY_DIR/storage-root" 2>/dev/null || true)
    local -a roots=("$CADDY_DIR" /caddy /root/.local/share/caddy /var/lib/caddy /.local/share/caddy)
    [ -z "$storage" ] || roots+=("$storage")
    candidates=$(timeout 4 find "${roots[@]}" -maxdepth 7 -type f -name "$TLS_DOMAIN.crt" 2>/dev/null || true)
    while IFS= read -r cert; do
      [ -n "$cert" ] || continue
      key=${cert%.crt}.key
      [ -s "$key" ] || continue
      timeout 3 openssl x509 -in "$cert" -noout -checkend 60 >/dev/null 2>&1 || continue
      timeout 3 openssl x509 -in "$cert" -noout -checkhost "$TLS_DOMAIN" 2>/dev/null | grep -q 'does match' || continue
      TLS_CERT=$cert; TLS_KEY=$key; echo '  已找到有效证书。'; return 0
    done <<<"$candidates"
    [ "$tries" = 3 ] || sleep 2
  done
  die '未找到有效证书：可能尚未签发、已过期或使用了自定义存储目录。请查看 journalctl -u meruru-caddy.service -n 80 --no-pager。'
  return 1
}
caddy_ws_sync() { # Reconstruct WS routes from metadata; roll back both files on reload failure.
  local tmp m domain p path current
  current=$(cat "$CADDY_DIR/domain" 2>/dev/null || true)
  [ -f "$CADDY_DIR/Caddyfile" ] || return 0
  tmp=$(mktemp -d) || return 1
  cp "$CADDY_DIR/Caddyfile" "$tmp/main" || { rm -rf "$tmp"; return 1; }
  [ ! -f "$CADDY_DIR/ws-routes.caddy" ] || cp "$CADDY_DIR/ws-routes.caddy" "$tmp/routes"
  : >"$tmp/new-routes"
  for m in "$META"/*.meta; do
    [ -f "$m" ] || continue
    [ "$(jq -r .type "$m")" = vless-ws ] || continue
    domain=$(jq -r .domain "$m"); p=$(jq -r .port "$m"); path=$(jq -r .path "$m")
    [ "$domain" = "$current" ] && port "$p" && [[ "$path" =~ ^/[A-Za-z0-9_-]+$ ]] || { rm -rf "$tmp"; die 'WS 节点域名、路径或端口与 Caddy 不一致。'; return 1; }
    printf 'reverse_proxy %s 127.0.0.1:%s\n' "$path" "$p" >>"$tmp/new-routes"
  done
  if [ ! -s "$tmp/new-routes" ] && [ ! -f "$CADDY_DIR/ws-routes.caddy" ]; then rm -rf "$tmp"; return 0; fi
  if ! grep -Fq "import $CADDY_DIR/ws-routes.caddy" "$CADDY_DIR/Caddyfile"; then
    # Upgrade only our generated single-site Caddyfile, never guess where to inject.
    [ "$(grep -c '^  header -Server$' "$CADDY_DIR/Caddyfile")" = 1 ] || { rm -rf "$tmp"; die 'Caddyfile 不是可自动迁移的 MERURU 配置。'; return 1; }
    awk -v inc="  import $CADDY_DIR/ws-routes.caddy" '{print} /^  header -Server$/ {print inc}' "$tmp/main" >"$CADDY_DIR/Caddyfile"
  fi
  mv "$tmp/new-routes" "$CADDY_DIR/ws-routes.caddy"
  if "$CADDY_BIN" validate --config "$CADDY_DIR/Caddyfile" --adapter caddyfile && { ! systemctl is-active --quiet meruru-caddy.service || systemctl reload meruru-caddy.service; }; then rm -rf "$tmp"; return 0; fi
  cp "$tmp/main" "$CADDY_DIR/Caddyfile"
  if [ -f "$tmp/routes" ]; then cp "$tmp/routes" "$CADDY_DIR/ws-routes.caddy"; else rm -f "$CADDY_DIR/ws-routes.caddy"; fi
  systemctl reload meruru-caddy.service >/dev/null 2>&1 || true
  rm -rf "$tmp"; die 'WS 反代应用失败，Caddy 已恢复原配置。'
}

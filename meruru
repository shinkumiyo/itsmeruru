  done
}
repair_tuic_alpn() { # Upgrade only missing/empty ALPN; preserve deliberately customised lists.
  local f backup active=0 failed=0; local -a changed=()
  backup=$(mktemp -d "$MERURU_HOME/.tuic-alpn-backup.XXXXXX") || return 1
  for f in "$CONF"/*.json; do
    [ -f "$f" ] || continue
    jq -e 'any(.inbounds[]?; .type=="tuic" and ((.tls.alpn//[])|length)==0)' "$f" >/dev/null 2>&1 || continue
    cp -p "$f" "$backup/$(basename "$f")" || { failed=1; break; }
    changed+=("$f")
    jq '.inbounds |= map(if .type=="tuic" and ((.tls.alpn//[])|length)==0 then .tls.alpn=["h3"] else . end)' "$f" >"$f.alpn-new" && mv "$f.alpn-new" "$f" || { failed=1; break; }
  done
  if [ "${#changed[@]}" = 0 ]; then rm -rf "$backup"; [ "$failed" = 0 ]; return; fi
  systemctl is-active --quiet meruru.service && active=1
  if [ "$failed" = 0 ]; then "$MERURU_BIN" check -c "$MAIN" -C "$CONF" || failed=1; fi
  if [ "$failed" = 0 ] && [ "$active" = 1 ]; then
    timeout 25 systemctl restart meruru.service || failed=1
    sleep 1
    systemctl is-active --quiet meruru.service || failed=1
  fi
  if [ "$failed" = 1 ]; then
    for f in "${changed[@]}"; do cp -p "$backup/$(basename "$f")" "$f"; rm -f "$f.alpn-new"; done
    [ "$active" = 0 ] || systemctl restart meruru.service
    die "TUIC ALPN 修复失败，已恢复原配置；备份：$backup"; return 1
  fi
  echo "  已为 ${#changed[@]} 个 TUIC 配置补齐 ALPN h3；凭据、端口不变。备份：$backup"
}
init() {
  local fresh=0 ver
  need_root
  command -v systemctl >/dev/null 2>&1 && [ -d /run/systemd/system ] || { die '此版本需要正在运行的 systemd；不支持原生 OpenRC Alpine 或普通容器。'; return 1; }
  case "$(uname -m)" in x86_64|amd64|aarch64|arm64) :;;*) die '目前仅支持 amd64 / arm64。'; return 1;;esac
  pkg_install || return 1
  manager_lock || return 1
  migrate_legacy_install || return 1
  mkdir -p "$MERURU_HOME/bin" "$CONF" "$META" "$MERURU_HOME/certs" || return 1
  secure_state || return 1
  if [ ! -x "$MERURU_BIN" ]; then
    ui_title '安装独立 sing-box 内核'
    download_core || { die '内核下载失败，未进入管理菜单。'; return 1; }
  fi
  ver=$("$MERURU_BIN" version 2>/dev/null) || { die '独立 sing-box 内核无法运行，请检查文件与架构。'; return 1; }
  ver=$(awk 'NR==1{print $3}' <<<"$ver")
  [[ "$ver" =~ ^[0-9]+\.[0-9]+\.[0-9]+ ]] && [ "$(printf '%s\n' 1.12.0 "$ver" | sort -V | head -n1)" = 1.12.0 ] || { die '现有内核版本不支持本脚本，需要 sing-box 1.12 或以上。'; return 1; }
  if [ ! -f "$MAIN" ] || [ ! -f "$SERVICE" ]; then
    ui_title '初始化 MERURU 配置与服务'
    write_base || return 1; fresh=1
  fi
  write_hop_script || return 1
  if ! "$MERURU_BIN" check -c "$MAIN" -C "$CONF"; then
    RECOVERY_MODE=1; echo '  配置检查失败，进入恢复模式：可查看日志、删除坏节点或回退脚本。'
    install_manager || return 1; return 0
  fi
  RECOVERY_MODE=0
  if [ -f "$MERURU_HOME/rtt-limit" ]; then local limit; limit=$(<"$MERURU_HOME/rtt-limit"); [[ "$limit" =~ ^[0-9]+$ ]] && [ "$limit" -ge 5 ] && [ "$limit" -le 200 ] && SNI_MAX_RTT_MS=$limit; fi
  repair_tuic_alpn || return 1
  if [ "$fresh" = 1 ]; then restart || { die 'MERURU 初次启动失败，请查看服务日志。'; return 1; }; fi
  install_manager || return 1
}

        jq --arg s "$DOMAIN" '.domain=$s' "$m" >"$m.tmp" && mv "$m.tmp" "$m"
        update_transaction "$n" && show_node "$n"
      else transaction_end; die '无此选项。'; fi;;
   *) transaction_end; return;; esac
}
uninstall_meruru() {
  local m type p hop t failed=0 ledger_copy
  echo -e "${YEL}此操作将删除 MERURU 核心、所有节点、证书、元数据及 systemd 服务。${OFF}"
  read -r -p '确认卸载 meruru 及全部节点？[y/N] ' confirm; [[ "$confirm" =~ ^[Yy]$ ]] || { echo '已取消。'; return; }
  systemctl disable --now meruru.service || { die '节点服务未能停止，取消卸载。'; return 1; }
  if [ -f "$CADDY_SERVICE" ]; then systemctl disable --now meruru-caddy.service || { die 'Caddy 未能停止，取消卸载。'; return 1; }; fi
  for m in "$META"/*.meta "$MERURU_HOME"/.quarantine.*/*.meta; do
    [ -f "$m" ] || continue; type=$(jq -r .type "$m"); p=$(jq -r .port "$m"); hop=$(jq -r '.hop // empty' "$m")
    network_remove_delta "$m" /dev/null || failed=1
  done
  # Include owned hop ranges and stale owned entries, retaining the ledger if any removal fails.
  if [ -f "$MERURU_HOME/firewall-owned.tsv" ]; then
    ledger_copy=$(mktemp) || return 1
    cp "$MERURU_HOME/firewall-owned.tsv" "$ledger_copy" || { rm -f "$ledger_copy"; return 1; }
    while IFS=$'\t' read -r t type p; do [ -z "$p" ] || firewall_close "$type" "$p" || failed=1; done <"$ledger_copy"
    rm -f "$ledger_copy"
  fi
  [ "$failed" = 0 ] || { die '规则清理失败，保留配置和规则记录；服务已停止，修复报错后可重试卸载。'; return 1; }
  remove_shortcuts
  if [ -f "$COMMAND_DIR/meruru-rollback" ] && grep -Fq '# meruru independent recovery' "$COMMAND_DIR/meruru-rollback"; then rm -f "$COMMAND_DIR/meruru-rollback"; fi
  rm -f "$SERVICE" "$CADDY_SERVICE"
  rm -rf "$MERURU_HOME"
  systemctl daemon-reload
  echo -e "${GRN}MERURU 已卸载，关联防火墙及端口跳跃 NAT 规则已尝试清理。${OFF}"
  exit 0
}

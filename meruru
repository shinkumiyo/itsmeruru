  ui_section '保存类别'; ui_item 1 '冷门可信'; ui_item 2 '热门可信'; read -r -p '保存类别 [1]：' category; [ "$category" = 2 ] && SNI_CATEGORY=热门可信 || SNI_CATEGORY=冷门可信
  read -r -p '用途说明（可留空）：' SNI_PURPOSE; SNI_PURPOSE=${SNI_PURPOSE:-用户手动导入的可信域名}
  read -r -p '确认开始扫描？[Y/n] ' confirm || return 1; [[ -z "$confirm" || "$confirm" =~ ^[Yy]$ ]] || return; sni_archive_begin import || return 1
  for host in "${domains[@]}"; do
    host=$(sed -E 's~^[a-zA-Z][a-zA-Z0-9+.-]*://~~; s~[/?#].*$~~' <<<"$host" | tr '[:upper:]' '[:lower:]' | tr -d '[:space:]')
    [[ "$host" =~ ^[a-z0-9.-]+$ ]] || { echo "跳过无效域名：$host"; continue; }
    tested=$((tested+1)); sni_probe "$host" import && passed=$((passed+1))
  done

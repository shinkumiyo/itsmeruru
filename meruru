    shadowsocks) printf 'ss://%s@%s:%s#%s\n' "$(printf '2022-blake3-aes-128-gcm:%s' "$(jq -r .password "$m")" | base64 | tr -d '\n')" "$ip" "$(jq -r .port "$m")" "$(jq -r .name "$m")";;
    direct) if jq -e '.landing_scheme and .landing_auth and .landing_suffix' "$m" >/dev/null 2>&1; then build_forwarded_standard "$(jq -r .landing_scheme "$m")" "$(jq -r .landing_auth "$m")" "$(jq -r .landing_suffix "$m")" "$ip" "$(jq -r .port "$m")"; elif jq -e '.landing_vless_auth and .landing_vless_suffix' "$m" >/dev/null 2>&1; then build_forwarded_standard vless "$(jq -r .landing_vless_auth "$m")" "$(jq -r .landing_vless_suffix "$m")" "$ip" "$(jq -r .port "$m")"; else printf 'TCP+UDP %s:%s -> %s:%s\n' "$ip" "$(jq -r .port "$m")" "$(jq -r .host "$m")" "$(jq -r .target_port "$m")"; fi;; esac
}
show_node() {
  local n=$1 m="$META/$1.meta" type link hop v2link ip; [ -f "$m" ] || { die '节点不存在。'; return 1; }; type=$(jq -r .type "$m")
  case "$type" in trojan|vless-ws) ip=;;*) ip=$(public_ip) || return 1;;esac
  link=$(node_link "$n" "$ip") || return 1
  echo -e "\n${CYA}━━━ $(jq -r .name "$m") · $type ━━━${OFF}"; echo "$link"

      [ "$new" != "$old" ] || { transaction_end; echo '端口未变化。'; return 0; }
      jq --argjson p "$new" '.inbounds[0].listen_port=$p' "$f" >"$f.tmp" && mv "$f.tmp" "$f"; jq --argjson p "$new" '.port=$p' "$m" >"$m.tmp" && mv "$m.tmp" "$m"
      update_transaction "$n" || return
      ;;

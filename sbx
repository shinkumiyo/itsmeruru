strip_hy2_hopping_query() { # Keep a forwarded Hy2 URI on the line server's one listening port.
  local suffix=$1 query fragment part rebuilt= first=1
  [[ "$suffix" = \?* ]] || { printf '%s' "$suffix"; return; }
  query=${suffix#\?}; fragment=
  if [[ "$query" = *\#* ]]; then fragment="#${query#*\#}"; query=${query%%\#*}; fi
  IFS='&' read -r -a _hy2_parts <<<"$query"
  for part in "${_hy2_parts[@]}"; do
    case "$part" in mport=*|ports=*|hopInterval=*|minHopInterval=*|maxHopInterval=*) continue;; esac
    if [ "$first" = 1 ]; then rebuilt=$part; first=0; else rebuilt+="&$part"; fi
  done
  [ -n "$rebuilt" ] && printf '?%s%s' "$rebuilt" "$fragment" || printf '%s' "$fragment"
}
parse_standard_landing_uri() { # Parses VLESS / AnyTLS / TUIC / Hy2 and retains usable client parameters.
  local uri=$1 body nofrag fragment authority endpoint range
  case "$uri" in vless://*) LANDING_SCHEME=vless;; trojan://*) LANDING_SCHEME=trojan;; anytls://*) LANDING_SCHEME=anytls;; tuic://*) LANDING_SCHEME=tuic;; hysteria2://*) LANDING_SCHEME=hysteria2;; hy2://*) LANDING_SCHEME=hy2;; *) return 1;; esac
  body=${uri#*://}; nofrag=${body%%\#*}; fragment=
  [ "$nofrag" != "$body" ] && fragment="#${body#*\#}"; authority=${nofrag%%\?*}
  [ "$authority" != "$nofrag" ] && VLESS_SUFFIX="?${nofrag#*\?}${fragment}" || VLESS_SUFFIX="$fragment"
  [[ "$authority" = *@* ]] || return 1; VLESS_AUTH=${authority%@*}; endpoint=${authority#*@}
  if [[ "$endpoint" =~ ^\[([^]]+)\]:([0-9]+)(-([0-9]+))?$ ]]; then VLESS_HOST=${BASH_REMATCH[1]}; VLESS_PORT=${BASH_REMATCH[2]}; range=${BASH_REMATCH[4]:-}
  elif [[ "$endpoint" =~ ^([^:]+):([0-9]+)(-([0-9]+))?$ ]]; then VLESS_HOST=${BASH_REMATCH[1]}; VLESS_PORT=${BASH_REMATCH[2]}; range=${BASH_REMATCH[4]:-}
  else return 1; fi
  [ -n "$VLESS_AUTH" ] && port "$VLESS_PORT" || return 1
  if [ -n "$range" ]; then
    port "$range" && [ "$VLESS_PORT" -le "$range" ] || return 1
    LANDING_HY2_RANGE="$VLESS_PORT-$range"
  else LANDING_HY2_RANGE=; fi
  # mport/ports identify ports on the *landing* server. They must never be copied
  # verbatim to the line server, whose forwarding listener uses another port.
  case "$LANDING_SCHEME" in hysteria2|hy2) VLESS_SUFFIX=$(strip_hy2_hopping_query "$VLESS_SUFFIX");; esac
}
build_forwarded_standard() { # $1 scheme, $2 userinfo, $3 suffix, $4 public line address, $5 local forward port
  printf '%s://%s@%s:%s%s\n' "$1" "$2" "$4" "$5" "$3"
}
add_protocol_landing() {
  local landing f client_link
  echo '粘贴落地机完整 VLESS / Trojan / AnyTLS / TUIC / Hysteria2 分享链接即可。'
  echo '会保留凭据、Reality/TLS 等参数，只自动替换为线路机地址与新端口。'
  read -r -p '落地节点链接：' landing; parse_standard_landing_uri "$landing" || { die '链接无法解析，需为 VLESS、Trojan、AnyTLS、TUIC 或 Hysteria2 分享链接。'; return; }
  echo "落地目标：$VLESS_HOST:$VLESS_PORT"
  [ -z "${LANDING_HY2_RANGE:-}" ] || echo "检测到落地 Hy2 跳跃范围 ${LANDING_HY2_RANGE}；线路机将自动使用单端口 UDP 透传。"
  ask_common || { die '节点名或监听端口无效。'; return; }; f="$CONF/$NAME.json"
  jq -n --arg tag "$NAME" --argjson p "$PORT" --arg dst "$VLESS_HOST" --argjson dp "$VLESS_PORT" '{inbounds:[{type:"direct",tag:$tag,listen:"::",listen_port:$p,override_address:$dst,override_port:$dp}]}' >"$f"
  jq -n --arg name "$NAME" --arg type direct --argjson port "$PORT" --arg host "$VLESS_HOST" --argjson target_port "$VLESS_PORT" --arg scheme "$LANDING_SCHEME" --arg auth "$VLESS_AUTH" --arg suffix "$VLESS_SUFFIX" '{name:$name,type:$type,port:$port,host:$host,target_port:$target_port,landing_scheme:$scheme,landing_auth:$auth,landing_suffix:$suffix}' >"$META/$NAME.meta"
  firewall_open tcp "$PORT"; firewall_open udp "$PORT"
  if check_commit "$f"; then
    client_link=$(build_forwarded_standard "$LANDING_SCHEME" "$VLESS_AUTH" "$VLESS_SUFFIX" "$(public_ip)" "$PORT")
    echo -e "${GRN}一键落地创建完成。客户端请使用以下线路机入口链接：${OFF}"; echo "$client_link"
    command -v qrencode >/dev/null && qrencode -t ANSIUTF8 "$client_link"
  else rm -f "$META/$NAME.meta"; fi
}
add_tunnel() {
  add_protocol_landing
}
node_link() { # prints one URI
  local m="$META/$1.meta" ip type; [ -f "$m" ] || return 1; ip=$(public_ip); type=$(jq -r .type "$m")
  case "$type" in
    trojan) printf 'trojan://%s@%s:%s?security=tls&sni=%s&type=tcp#%s\n' "$(jq -r .password "$m")" "$(jq -r .domain "$m")" "$(jq -r .port "$m")" "$(jq -r .domain "$m")" "$(jq -r .name "$m")";;
    vless-ws) printf 'vless://%s@%s:443?encryption=none&security=tls&type=ws&sni=%s&host=%s&path=%s#%s\n' "$(jq -r .uuid "$m")" "$(jq -r .domain "$m")" "$(jq -r .domain "$m")" "$(jq -r .domain "$m")" "$(jq -r '.path | @uri' "$m")" "$(jq -r .name "$m")";;
    vless) printf 'vless://%s@%s:%s?encryption=none&flow=xtls-rprx-vision&security=reality&sni=%s&fp=%s&pbk=%s&sid=%s&allowInsecure=1&type=tcp#%s\n' "$(jq -r .uuid "$m")" "$ip" "$(jq -r .port "$m")" "$(jq -r .domain "$m")" "$DEFAULT_FP" "$(jq -r .pbk "$m")" "$(jq -r .sid "$m")" "$(jq -r .name "$m")";;
    anytls) printf 'anytls://%s@%s:%s?security=reality&sni=%s&fp=%s&pbk=%s&sid=%s&allowInsecure=1#%s\n' "$(jq -r .password "$m")" "$ip" "$(jq -r .port "$m")" "$(jq -r .domain "$m")" "$DEFAULT_FP" "$(jq -r .pbk "$m")" "$(jq -r .sid "$m")" "$(jq -r .name "$m")";;
    # Official Hysteria2 URI: port hopping is the authority port itself, not an mport query parameter.
    hysteria2) local hop; hop=$(jq -r '.hop // empty' "$m"); printf 'hysteria2://%s@%s:%s/?insecure=1#%s\n' "$(jq -r .password "$m")" "$ip" "${hop:-$(jq -r .port "$m")}" "$(jq -r .name "$m")";;
    tuic) printf 'tuic://%s:%s@%s:%s?congestion_control=bbr&allow_insecure=1#%s\n' "$(jq -r .uuid "$m")" "$(jq -r .password "$m")" "$ip" "$(jq -r .port "$m")" "$(jq -r .name "$m")";;
    shadowsocks) printf 'ss://%s@%s:%s#%s\n' "$(printf '2022-blake3-aes-128-gcm:%s' "$(jq -r .password "$m")" | base64 | tr -d '\n')" "$ip" "$(jq -r .port "$m")" "$(jq -r .name "$m")";;
    direct) if jq -e '.landing_scheme and .landing_auth and .landing_suffix' "$m" >/dev/null 2>&1; then build_forwarded_standard "$(jq -r .landing_scheme "$m")" "$(jq -r .landing_auth "$m")" "$(jq -r .landing_suffix "$m")" "$ip" "$(jq -r .port "$m")"; elif jq -e '.landing_vless_auth and .landing_vless_suffix' "$m" >/dev/null 2>&1; then build_forwarded_standard vless "$(jq -r .landing_vless_auth "$m")" "$(jq -r .landing_vless_suffix "$m")" "$ip" "$(jq -r .port "$m")"; else printf 'TCP+UDP %s:%s -> %s:%s\n' "$ip" "$(jq -r .port "$m")" "$(jq -r .host "$m")" "$(jq -r .target_port "$m")"; fi;; esac
}
show_node() {

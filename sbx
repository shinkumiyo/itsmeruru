#!/usr/bin/env bash
# Compatibility installer for the former sbx download URL.
# The active manager, service and configuration are named meruru.
task_dir=$(mktemp -d) || exit 1
trap 'rm -rf "$task_dir"' EXIT
url=https://raw.githubusercontent.com/shinkumiyo/itsmeruru/main/meruru
if command -v curl >/dev/null 2>&1; then
  curl -fL --retry 2 --connect-timeout 10 --max-time 120 "$url" -o "$task_dir/meruru" || exit 1
elif command -v wget >/dev/null 2>&1; then
  wget -T 30 -t 3 -O "$task_dir/meruru" "$url" || exit 1
else
  echo '请先安装 curl 或 wget。' >&2; exit 1
fi
bash -n "$task_dir/meruru" && bash "$task_dir/meruru" "$@"

  [ -n "$listeners" ] || return 1
  pid=$(systemctl show sbx-caddy.service -p MainPID --value 2>/dev/null)
  if [[ "$pid" =~ ^[1-9][0-9]*$ ]]; then
    listeners=$(printf '%s\n' "$listeners" | grep -v "pid=$pid,")
  fi
  [ -n "$listeners" ]
}

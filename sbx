shortcut_valid() { [[ "$1" =~ ^[A-Za-z][A-Za-z0-9_-]{0,23}$ ]]; }
shortcut_name() {
  local n; n=$(cat "$SBX_HOME/shortcut" 2>/dev/null || true)
  shortcut_valid "$n" && printf '%s' "$n" || printf M
}
shortcut_variants() { printf '%s\n' "$1" "${1,,}" "${1^^}" | sort -u; }
shortcut_owned() {
  local path=$1
  [ "$(readlink -f "$path" 2>/dev/null)" = "$(readlink -f "$SBX_HOME/bin/manager")" ] && return 0
  # Recognise only the previous fixed-name manager entries during migration.
  case "$path" in "$COMMAND_DIR/M"|"$COMMAND_DIR/m") [ -f "$path" ] && grep -Fq '# sbx - self-contained sing-box manager' "$path";;*) return 1;;esac
}
remove_shortcuts() {
  local n
  while IFS= read -r n; do
    shortcut_owned "$COMMAND_DIR/$n" && rm -f "$COMMAND_DIR/$n"
  done < <(shortcut_variants "$(shortcut_name)")
  return 0
}
set_shortcut() {
  local name=$1 old n found target="$SBX_HOME/bin/manager"
  shortcut_valid "$name" || { die '命令需以英文字母开头，最多 24 位，可包含数字、下划线和连字符。'; return 1; }
  old=$(shortcut_name)
  while IFS= read -r n; do
    found=$(command -v "$n" 2>/dev/null || true)
    if { [ -e "$COMMAND_DIR/$n" ] || [ -L "$COMMAND_DIR/$n" ]; } && ! shortcut_owned "$COMMAND_DIR/$n"; then
      die "命令 $n 已被其他文件占用，请换一个名称。"; return 1
    fi
    if [ -n "$found" ] && ! shortcut_owned "$found"; then
      die "命令 $n 已存在：$found；请换一个名称。"; return 1
    fi
  done < <(shortcut_variants "$name")
  [ -x "$target" ] || { die '管理脚本尚未安装。'; return 1; }
  while IFS= read -r n; do
    ln -sfnT "$target" "$COMMAND_DIR/$n" || { die '快捷命令创建失败，原快捷命令保留。'; return 1; }
  done < <(shortcut_variants "$name")
  printf '%s\n' "$name" >"$SBX_HOME/shortcut" || return 1
  while IFS= read -r n; do
    case "$n" in "$name"|"${name,,}"|"${name^^}") continue;;esac
    shortcut_owned "$COMMAND_DIR/$n" && rm -f "$COMMAND_DIR/$n"
  done < <(shortcut_variants "$old")
  hash -r
  return 0
}
change_shortcut() {
  local n
  ui_title '修改快捷命令'
  echo "  当前：$(shortcut_name)；输入新名称，自动建立全大写、全小写入口。"
  read -r -p '  新命令（回车取消）：' n; [ -n "$n" ] || return 0
  set_shortcut "$n" && echo "  已修改：$n / ${n,,} / ${n^^}。退出后即可使用。"
}
install_manager() {
  local source=${BASH_SOURCE[0]} target="$SBX_HOME/bin/manager"
  [ -f "$source" ] && [ -r "$source" ] || return 0
  if [ "$(readlink -f "$source")" != "$(readlink -f "$target")" ]; then
    bash -n "$source" && install -D -m 755 "$source" "$target" || { die '管理命令安装失败。'; return 1; }
  fi
  set_shortcut "$(shortcut_name)"
}
init() {
  local fresh=0 ver
  need_root
  command -v systemctl >/dev/null 2>&1 && [ -d /run/systemd/system ] || { die '此版本需要正在运行的 systemd；不支持原生 OpenRC Alpine 或普通容器。'; return 1; }
  case "$(uname -m)" in x86_64|amd64|aarch64|arm64) :;;*) die '目前仅支持 amd64 / arm64。'; return 1;;esac
  pkg_install || return 1
  mkdir -p "$SBX_HOME/bin" "$CONF" "$META" "$SBX_HOME/certs" || return 1
  if [ ! -x "$SBX_BIN" ]; then
    ui_title '安装独立 sing-box 内核'
    download_core || { die '内核下载失败，未进入管理菜单。'; return 1; }
  fi
  ver=$("$SBX_BIN" version 2>/dev/null) || { die '独立 sing-box 内核无法运行，请检查文件与架构。'; return 1; }
  ver=$(awk 'NR==1{print $3}' <<<"$ver")
  [[ "$ver" =~ ^[0-9]+\.[0-9]+\.[0-9]+ ]] && [ "$(printf '%s\n' 1.12.0 "$ver" | sort -V | head -n1)" = 1.12.0 ] || { die '现有内核版本不支持本脚本，需要 sing-box 1.12 或以上。'; return 1; }
  if [ ! -f "$MAIN" ] || [ ! -f "$HOP" ] || [ ! -f "$SERVICE" ]; then
    ui_title '初始化 SBX 配置与服务'
    write_base || return 1; fresh=1
  fi
  "$SBX_BIN" check -c "$MAIN" -C "$CONF" || { die '现有配置检查失败，请根据上方错误修复；原配置未删除。'; return 1; }
  if [ "$fresh" = 1 ]; then restart || { die 'SBX 初次启动失败，请查看服务日志。'; return 1; }; fi
  install_manager || return 1
}

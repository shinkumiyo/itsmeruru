  jq -n --arg name "$NAME" --arg type hysteria2 --argjson port "$PORT" --arg password "$pass" --arg hop "$HOPR" '{name:$name,type:$type,port:$port,password:$password,hop:$hop}' >"$META/$NAME.meta"; firewall_open udp "$PORT"; [ -z "$HOPR" ] || firewall_open udp "$HOPR"; if check_commit "$f"; then [ -z "$HOPR" ] || bash "$HOP"; show_node "$NAME"; [ -z "$HOPR" ] || echo -e "${YEL}请同时在云厂商安全组放行 UDP ${HOPR}。${OFF}"; else rm -f "$META/$NAME.meta"; fi
}

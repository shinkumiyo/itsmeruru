hop_remove() { local hop=$1 target=$2 range t; range=${hop/-/:}; for t in iptables ip6tables; do command -v "$t" >/dev/null || continue; while "$t" -t nat -C PREROUTING -p udp --dport "$range" -j REDIRECT --to-ports "$target" 2>/dev/null; do "$t" -t nat -D PREROUTING -p udp --dport "$range" -j REDIRECT --to-ports "$target" 2>/dev/null || break; done; done; }
port_busy() { # $1 port, $2 optional node name whose currently bound port is permitted

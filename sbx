  read -r -p '用途说明（可留空）：' SNI_PURPOSE; SNI_PURPOSE=${SNI_PURPOSE:-用户手动导入的可信域名}
  read -r -p '确认开始扫描？[Y/n] ' confirm; [[ -z "$confirm" || "$confirm" =~ ^[Yy]$ ]] || return; sni_archive_begin import
  for host in "${domains[@]}"; do
    host=$(sed -E 's#^[a-zA-Z][a-zA-Z0-9+.-]*://##; s#[/?#].*$##' <<<"$host" | tr '[:upper:]' '[:lower:]' | tr -d '[:space:]')

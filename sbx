  sni_archive_begin revalidate; cp "$db" "$bak"; : >"$db"; : >"$SBX_HOME/sni_candidates.txt"
  while IFS=$'\t' read -r d category source purpose ip rtt verified; do echo -e "${CYA}复测：$d（原 RTT ${rtt}ms）${OFF}"; SNI_CATEGORY="$category"; SNI_PURPOSE="$purpose"; sni_probe "$d" "$source" || echo '  已从活跃候选中移除。'; done <"$bak"

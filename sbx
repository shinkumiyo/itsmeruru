   3) if [ "$type" = hysteria2 ]; then local oldhop; oldhop=$(jq -r '.hop // empty' "$m"); read -r -p '新范围（如 20000-30000，留空关闭）：' hop; [[ -z "$hop" || "$hop" =~ ^[0-9]{1,5}-[0-9]{1,5}$ ]] || { transaction_end; die '格式错误。'; return; }; jq --arg h "$hop" '.hop=$h' "$m" >"$m.tmp" && mv "$m.tmp" "$m"; update_transaction "$n" || return; [ -z "$oldhop" ] || { firewall_close udp "$oldhop"; hop_remove "$oldhop" "$old"; }; [ -z "$hop" ] || { firewall_open udp "$hop"; bash "$HOP"; };
      elif [ "$type" = direct ]; then read -r -p '新目标主机/IP：' target; read -r -p '新目标端口：' target_port; [ -n "$target" ] && port "$target_port" || { transaction_end; die '目标无效。'; return; }; jq --arg h "$target" --argjson p "$target_port" '.inbounds[0].override_address=$h | .inbounds[0].override_port=$p' "$f" >"$f.tmp" && mv "$f.tmp" "$f"; jq --arg h "$target" --argjson p "$target_port" '.host=$h | .target_port=$p' "$m" >"$m.tmp" && mv "$m.tmp" "$m"; update_transaction "$n";
      elif [ "$type" = vless-ws ]; then

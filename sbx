  if [ -s "$db" ]; then
    sni_sort_active
    for group in 冷门可信 热门可信 自定义导入; do
    echo; echo "── $group ──"
    while IFS=$'\t' read -r d category source purpose ip rtt verified; do
      if [ "$group" = 自定义导入 ]; then [ "$source" = import ] || continue
      else [ "$source" != import ] && [ "$category" = "$group" ] || continue; fi
      if [[ "$rtt" =~ ^[0-9]+([.][0-9]+)?$ ]] && [[ "$ip" =~ ^[0-9.]+$ ]]; then
        measured=$((measured+1)); printf '  %s  [%s]  RTT: %sms\n    用途：%s\n    来源：%s  IP：%s  复测：%s\n' "$d" "$category" "$rtt" "$purpose" "$source" "$ip" "$verified"
        sni_history_summary "$d"
      else
        pending=$((pending+1))
      fi
    done < <(sni_recommended_rows)
    done

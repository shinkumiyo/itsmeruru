  systemctl disable --now sbx.service >/dev/null 2>&1
  systemctl disable --now sbx-caddy.service >/dev/null 2>&1
  for m in "$META"/*.meta; do
    [ -f "$m" ] || continue; type=$(jq -r .type "$m"); p=$(jq -r .port "$m"); hop=$(jq -r '.hop // empty' "$m")
    case "$type" in hysteria2|tuic) firewall_close udp "$p";; *) firewall_close tcp "$p"; firewall_close udp "$p";; esac

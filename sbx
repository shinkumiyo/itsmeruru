sni_sort_active() { # Only measured records are active and eligible for node creation.
  local db="$SBX_HOME/sni-candidates.tsv"; [ -s "$db" ] || { : >"$SBX_HOME/sni_candidates.txt"; return 0; }; sni_normalize_db
  sort -t$'\t' -k6,6n -k1,1 "$db" -o "$db"
  awk -F'\t' '$6 ~ /^[0-9]+(\.[0-9]+)?$/ && $5 ~ /^[0-9.]+$/ {print $1}' "$db" >"$SBX_HOME/sni_candidates.txt"
}
sni_view() {
  local db="$SBX_HOME/sni-candidates.tsv" measured=0 pending=0 group

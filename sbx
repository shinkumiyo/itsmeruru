#!/usr/bin/env bash
# sbx - self-contained sing-box manager (Debian/Ubuntu first; common RPM systems supported)
# Install: bash /root/sbx; then use M or m.
# This script intentionally never resolves or invokes a system "sing-box" command.

SBX_HOME=/etc/sbx
SBX_BIN="$SBX_HOME/bin/sing-box"
CONF="$SBX_HOME/conf"
META="$SBX_HOME/meta"
MAIN="$SBX_HOME/config.json"
HOP="$SBX_HOME/apply_hop.sh"
SERVICE=/etc/systemd/system/sbx.service
CADDY_BIN="$SBX_HOME/bin/caddy"
CADDY_DIR="$SBX_HOME/caddy"
CADDY_SERVICE=/etc/systemd/system/sbx-caddy.service
COMMAND_DIR=/usr/local/bin
RED='\033[31m'; GRN='\033[32m'; YEL='\033[33m'; CYA='\033[36m'; OFF='\033[0m'
DEFAULT_FP=safari
SNI_MAX_RTT_MS=30
BOLD='\033[1m'; DIM='\033[2m'
# Open horizontal rules keep Chinese labels aligned across terminal fonts.
ui_rule() { printf '%b  ──────────────────────────────────────────────%b\n' "$DIM" "$OFF"; }
ui_title() { printf '\n%b  itsmeruru%b  /  %s\n' "$BOLD$CYA" "$OFF" "$1"; ui_rule; }
ui_section() { printf '\n%b  %s%b\n' "$DIM" "$1" "$OFF"; }
ui_item() { printf '  %b%2s%b  %s\n' "$CYA" "$1" "$OFF" "$2"; }

die() { echo -e "${RED}Error: $*${OFF}" >&2; return 1; }
need_root() { [ "${EUID:-$(id -u)}" -eq 0 ] || { die 'Run as root.'; exit 1; }; }
pause() { printf '\n'; read -r -p '  按 Enter 继续 … ' _; }
safe_name() { [[ "$1" =~ ^[A-Za-z0-9_-]{1,48}$ ]]; }
json() { jq -cn "$@"; }
uuid() { [ -r /proc/sys/kernel/random/uuid ] && cat /proc/sys/kernel/random/uuid || openssl rand -hex 16 | sed 's/^/00000000-0000-4000-8000-/'; }
port() { [[ "$1" =~ ^[0-9]+$ ]] && [ "$1" -ge 1 ] && [ "$1" -le 65535 ]; }
public_ip() { local ip; ip=$(curl -4fsS --max-time 5 https://api.ipify.org 2>/dev/null || true); [ -n "$ip" ] || ip=$(hostname -I | awk '{for(i=1;i<=NF;i++) if($i !~ /:/){print $i;exit}}'); [ -n "$ip" ] || ip=$(curl -6fsS --max-time 5 https://api64.ipify.org 2>/dev/null || hostname -I | awk '{for(i=1;i<=NF;i++) if($i ~ /:/){print $i;exit}}'); [[ "$ip" = *:* ]] && printf '[%s]' "$ip" || printf '%s' "$ip"; }
restart() { systemctl daemon-reload; systemctl restart sbx.service; }

pkg_install() {
  local cmd manager pkg ca_missing=0; local -a missing=() pkgs=()
  for cmd in curl jq openssl tar gzip unzip iptables ip6tables qrencode ss dig getent hostname timeout mktemp sort shuf date install readlink awk sed grep find; do
    command -v "$cmd" >/dev/null 2>&1 || missing+=("$cmd")
  done
  [ -s /etc/ssl/certs/ca-certificates.crt ] || [ -s /etc/pki/tls/certs/ca-bundle.crt ] || [ -s /etc/ssl/cert.pem ] || ca_missing=1
  [ "${#missing[@]}" -gt 0 ] || [ "$ca_missing" = 1 ] || return 0
  ui_title '安装前置组件'
  echo "  缺少工具：${missing[*]:-无}"
  [ "$ca_missing" = 0 ] || echo '  缺少系统 CA 证书包。'
  if command -v apt-get >/dev/null; then manager=apt
  elif command -v dnf >/dev/null; then manager=dnf
  elif command -v yum >/dev/null; then manager=yum
  else die '自动安装支持 Debian / Ubuntu 和常见 RPM 发行版；当前未找到包管理器。'; return 1; fi
  for cmd in "${missing[@]}"; do
    case "$cmd" in
      iptables|ip6tables) pkg=iptables;;
      ss) [ "$manager" = apt ] && pkg=iproute2 || pkg=iproute;;
      dig) [ "$manager" = apt ] && pkg=dnsutils || pkg=bind-utils;;
      getent) [ "$manager" = apt ] && pkg=libc-bin || pkg=glibc-common;;
      timeout|mktemp|sort|shuf|date|install|readlink) pkg=coreutils;;
      awk) pkg=gawk;;find) pkg=findutils;;*) pkg=$cmd;;
    esac
    [[ " ${pkgs[*]} " = *" $pkg "* ]] || pkgs+=("$pkg")
  done
  [ "$ca_missing" = 0 ] || pkgs+=(ca-certificates)
  echo "  安装软件包：${pkgs[*]}"
  case "$manager" in
    apt) DEBIAN_FRONTEND=noninteractive apt-get -o APT::Update::Error-Mode=any update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends "${pkgs[@]}" || { die '依赖安装失败，请检查软件源、系统时间及 apt 锁。'; return 1; };;
    dnf|yum) "$manager" install -y "${pkgs[@]}" || { die '依赖安装失败，请检查软件源及包管理器日志。'; return 1; };;
  esac
  hash -r
  for cmd in "${missing[@]}"; do command -v "$cmd" >/dev/null 2>&1 || { die "安装后仍缺少 $cmd，停止初始化。"; return 1; }; done
  echo -e "${GRN}前置组件已就绪。${OFF}"
}

download_core() {
  local arch asset url tmp ver
  case "$(uname -m)" in x86_64|amd64) arch=amd64;; aarch64|arm64) arch=arm64;; *) die "Unsupported architecture: $(uname -m)"; return;; esac
  echo 'Fetching latest stable sing-box release from GitHub...'
  url=$(curl -fsSL --retry 3 --connect-timeout 10 https://api.github.com/repos/SagerNet/sing-box/releases/latest | jq -r --arg a "linux-$arch.tar.gz" '.assets[] | select(.name | endswith($a)) | .browser_download_url' | head -n1)
  [ -n "$url" ] && [ "$url" != null ] || { die 'Could not find the Linux release asset.'; return; }
  ver=$(basename "$url" | sed -E 's/^sing-box-([0-9]+\.[0-9]+\.[0-9]+).*/\1/')
  [ "$(printf '%s\n' 1.12.0 "$ver" | sort -V | head -n1)" = 1.12.0 ] || { die "Latest release $ver is older than 1.12.0."; return; }
  tmp=$(mktemp -d); trap 'rm -rf "$tmp"' RETURN
  curl -fL --retry 3 --connect-timeout 15 "$url" -o "$tmp/core.tar.gz" || return
  tar -xzf "$tmp/core.tar.gz" -C "$tmp" || return
  install -D -m 755 "$(find "$tmp" -type f -name sing-box | head -n1)" "$SBX_BIN" || return
  "$SBX_BIN" version || { rm -f "$SBX_BIN"; die 'Downloaded core cannot run.'; return; }
  trap - RETURN; rm -rf "$tmp"
}

download_caddy() { # Independent Caddy binary: no third-party installer or system package is used.
  local arch url tmp
  case "$(uname -m)" in x86_64|amd64) arch=amd64;; aarch64|arm64) arch=arm64;; *) die "Caddy unsupported architecture: $(uname -m)"; return 1;; esac
  echo 'Fetching latest stable Caddy release from GitHub...'
  url=$(curl -fsSL --retry 3 --connect-timeout 10 https://api.github.com/repos/caddyserver/caddy/releases/latest | jq -r --arg a "linux_$arch.tar.gz" '.assets[] | select(.name | endswith($a)) | .browser_download_url' | head -n1)
  [ -n "$url" ] && [ "$url" != null ] || { die 'Could not find a Caddy Linux release asset.'; return 1; }
  tmp=$(mktemp -d); curl -fL --retry 3 --connect-timeout 15 "$url" -o "$tmp/caddy.tar.gz" || { rm -rf "$tmp"; return 1; }
  tar -xzf "$tmp/caddy.tar.gz" -C "$tmp" || { rm -rf "$tmp"; return 1; }
  install -D -m 755 "$(find "$tmp" -type f -name caddy | head -n1)" "$CADDY_BIN" || { rm -rf "$tmp"; return 1; }
  "$CADDY_BIN" version || { rm -f "$CADDY_BIN"; rm -rf "$tmp"; die 'Downloaded Caddy cannot run.'; return 1; }
  rm -rf "$tmp"
}

write_base() {
  mkdir -p "$CONF" "$META" "$SBX_HOME/bin" "$SBX_HOME/certs"
  [ -f "$MAIN" ] || cat >"$MAIN" <<'EOF'
{
  "log":{"level":"warn","timestamp":true},
  "outbounds":[{"type":"direct","tag":"direct"}],
  "route":{"auto_detect_interface":true,"rules":[{"ip_is_private":true,"outbound":"direct"}],"final":"direct"}
}
EOF
  cat >"$HOP" <<'EOF'
#!/usr/bin/env bash
# Generated rules are intentionally reconstructed from metadata on each service start.
set +e
for m in /etc/sbx/meta/*.meta; do
  [ -f "$m" ] || continue
  [ "$(jq -r '.type' "$m" 2>/dev/null)" = hysteria2 ] || continue
  target=$(jq -r '.port' "$m"); range=$(jq -r '.hop // empty' "$m")
  [ -n "$range" ] || continue
  IFS='-' read -r first last <<EOF2
$range
EOF2
  for tool in iptables ip6tables; do
    command -v "$tool" >/dev/null || continue
    "$tool" -t nat -C PREROUTING -p udp --dport "$first:$last" -j REDIRECT --to-ports "$target" 2>/dev/null || "$tool" -t nat -A PREROUTING -p udp --dport "$first:$last" -j REDIRECT --to-ports "$target" 2>/dev/null
  done
done
EOF
  chmod 700 "$HOP"
  cat >"$SERVICE" <<EOF
[Unit]
Description=SBX standalone sing-box
After=network-online.target
Wants=network-online.target
[Service]
Type=simple
ExecStart=$SBX_BIN run -c $MAIN -C $CONF
ExecStartPost=/bin/bash $HOP
Restart=on-failure
RestartSec=3
LimitNOFILE=1048576
[Install]
WantedBy=multi-user.target
EOF
  systemctl daemon-reload; systemctl enable sbx.service >/dev/null 2>&1
}

check_commit() { # node file is already staged; delete it if merged config is invalid
  local f=$1 err
  err=$(mktemp)
  if ! "$SBX_BIN" check -c "$MAIN" -C "$CONF" 2>"$err"; then
    echo -e "${RED}sing-box validation failed; change rolled back:${OFF}"; cat "$err"; rm -f "$f" "$err"; return 1
  fi
  rm -f "$err"; restart || { rm -f "$f"; restart >/dev/null 2>&1; die '服务重启失败；已移除新节点并恢复上一配置。'; return 1; }
  echo -e "${GRN}Saved and started.${OFF}"
}

firewall_open() {
  local proto=$1 p=${2//-/:}
  if command -v ufw >/dev/null && ufw status 2>/dev/null | grep -q 'Status: active'; then ufw allow "$p/$proto" >/dev/null; fi
  if command -v firewall-cmd >/dev/null && firewall-cmd --state >/dev/null 2>&1; then firewall-cmd --permanent --add-port="$p/$proto" >/dev/null && firewall-cmd --reload >/dev/null; fi
}
firewall_close() {
  local proto=$1 p=${2//-/:}
  if command -v ufw >/dev/null && ufw status 2>/dev/null | grep -q 'Status: active'; then ufw delete allow "$p/$proto" >/dev/null 2>&1; fi
  if command -v firewall-cmd >/dev/null && firewall-cmd --state >/dev/null 2>&1; then firewall-cmd --permanent --remove-port="$p/$proto" >/dev/null 2>&1; firewall-cmd --reload >/dev/null 2>&1; fi
}
random_free_port() {
  local candidate tries=0
  while [ "$tries" -lt 80 ]; do
    candidate=$((15000 + RANDOM % 40001)); tries=$((tries+1))
    port_busy "$candidate" || { printf '%s' "$candidate"; return 0; }
  done
  return 1
}
hop_range_free() { # $1 first port, $2 last port: avoid all existing listeners and Hy2 hop ranges.
  local first=$1 last=$2 m p h hs he
  for m in "$META"/*.meta; do
    [ -f "$m" ] || continue; p=$(jq -r '.port // 0' "$m")
    [ "$p" -ge "$first" ] && [ "$p" -le "$last" ] && return 1
    h=$(jq -r '.hop // empty' "$m"); [ -n "$h" ] || continue; IFS=- read -r hs he <<<"$h"
    [ "$first" -le "$he" ] && [ "$last" -ge "$hs" ] && return 1
  done
  return 0
}
random_hop_range() { # A range contains exactly ten UDP ports, inclusive.
  local first last tries=0
  while [ "$tries" -lt 80 ]; do
    first=$((20000 + RANDOM % 40000)); last=$((first + 9)); tries=$((tries+1))
    hop_range_free "$first" "$last" && { printf '%s-%s' "$first" "$last"; return 0; }
  done
  return 1
}
ask_common() {
  local suggested_name suggested_port
  suggested_name="node-$(openssl rand -hex 3)"; suggested_port=$(random_free_port) || { die '无法自动选择空闲端口。'; return 1; }
  read -r -p "节点名称 [${suggested_name}]：" NAME; NAME=${NAME:-$suggested_name}; safe_name "$NAME" || return 1; [ ! -e "$CONF/$NAME.json" ] || return 1
  read -r -p "监听端口 [${suggested_port}]：" PORT; PORT=${PORT:-$suggested_port}; port "$PORT" && ! port_busy "$PORT" || return 1
}
reality_tls() { # private TLS object carries _public only until it is written to a config
  local sn=$1 pair key pub sid; pair=$($SBX_BIN generate reality-keypair) || return
  key=$(awk '/PrivateKey/{print $2}' <<<"$pair"); pub=$(awk '/PublicKey/{print $2}' <<<"$pair"); sid=$(openssl rand -hex 8)
  [ -n "$key" ] && [ -n "$pub" ] || return 1
  jq -cn --arg sn "$sn" --arg key "$key" --arg pub "$pub" --arg sid "$sid" '{enabled:true,server_name:$sn,reality:{enabled:true,handshake:{server:$sn,server_port:443},private_key:$key,short_id:[$sid]},_public:$pub}'
}
reality_public() { $SBX_BIN generate reality-keypair | awk '/PublicKey/{print $2}'; }
sni_dns_cdn_check() { # A brand-owned hostname is not evidence of brand-owned delivery.
  local d=$1 ip=$2 chain row data next count=0
  chain=$d
  while [ "$count" -lt 8 ]; do
    count=$((count+1)); next=
    if command -v dig >/dev/null 2>&1; then
      row=$(dig +time=2 +tries=1 +noall +answer "$chain" CNAME 2>/dev/null) || return 2
      next=$(awk '$4=="CNAME" {print $5;exit}' <<<"$row")
    else
      data=$(curl -fsS --connect-timeout 2 --max-time 4 -G 'https://dns.google/resolve' --data-urlencode "name=$chain" --data-urlencode 'type=CNAME' 2>/dev/null) || return 2
      jq -e '.Status==0' <<<"$data" >/dev/null 2>&1 || return 2
      next=$(jq -r '[.Answer[]? | select(.type==5) | .data][0] // empty' <<<"$data")
    fi
    [ -n "$next" ] || return 0
    next=${next,,}; next=${next%.}
    if [[ "$next" =~ (^|\.)(cloudflare\.net|cloudflare\.com|cloudflare-dns\.com|akamaiedge\.net|akamaized\.net|akamai\.net|akamaitechnologies\.com|edgesuite\.net|edgekey\.net|akadns\.net|cloudfront\.net|awsglobalaccelerator\.com|fastly\.net|fastlylb\.net|map\.fastly\.net|cdn77\.org|cdn77\.net|b-cdn\.net|bunnycdn\.com|stackpathdns\.com|stackpathcdn\.com|hwcdn\.net|llnwd\.net|edgecastcdn\.net|cdn\.arvancloud\.ir)$ ]]; then
      echo "  第三方 CDN DNS 特征：$next"; return 1
    fi
    if [[ "$next" =~ (^|\.)(azureedge\.net|azurefd\.net)$ ]] && [[ ! "$d" =~ (^|\.)(microsoft\.com|office\.com|bing\.com|xbox\.com|surface\.com)$ ]]; then
      echo "  第三方 Microsoft CDN DNS 特征：$next"; return 1
    fi
    chain=$next
  done
  return 2
}
test_sni() { # Three TCP samples (median) gate first, then strict TLS/HTTP screening.
  local d=$1 official_pool=${2:-} hdr tls cert ms sample start_ns end_ns ip tls13 h2 x25519 san; local -a samples=()
  SNI_LAST_RTT=; SNI_LAST_IP=; [[ "$d" =~ ^[A-Za-z0-9.-]+$ ]] || return 1
  ip=$(getent ahostsv4 "$d" 2>/dev/null | awk 'NR==1{print $1}'); [ -n "$ip" ] || { echo '  DNS 解析失败'; return 1; }
  hdr=$(mktemp); tls=$(mktemp); cert=$(mktemp)
  # Three fast TCP handshakes give a stable median while still rejecting slow sites before costly TLS work.
  for sample in 1 2 3; do
    start_ns=$(date +%s%N); timeout 2 bash -c "exec 3<>/dev/tcp/$ip/443" 2>/dev/null || { rm -f "$hdr" "$tls" "$cert"; echo "  TCP 443 第 ${sample} 次连接失败"; return 1; }; end_ns=$(date +%s%N)
    samples+=("$(awk -v s="$start_ns" -v e="$end_ns" 'BEGIN {printf "%.3f", (e-s)/1000000}')")
  done
  ms=$(printf '%s\n' "${samples[@]}" | sort -n | sed -n '2p')
  SNI_LAST_RTT=$ms; SNI_LAST_IP=$ip
  if awk -v rtt="$ms" -v limit="$SNI_MAX_RTT_MS" 'BEGIN {exit !(rtt > limit)}'; then rm -f "$hdr" "$tls" "$cert"; echo "  TCP RTT 中位数 ${ms} ms（${samples[*]}），超过阈值 ${SNI_MAX_RTT_MS} ms，已提前淘汰"; return 4; fi
  # Check DNS as well as response headers: third-party CDNs can hide Server headers.
  local dns_rc
  sni_dns_cdn_check "$d" "$ip"; dns_rc=$?
  if [ "$dns_rc" -ne 0 ]; then
    rm -f "$hdr" "$tls" "$cert"
    [ "$dns_rc" = 1 ] && return 2
    echo '  CDN DNS 检查不可用，暂不入库（安装 dig 可使用本机 DNS 检查）'; return 6
  fi
  # Pin HTTP and OpenSSL verification to the same resolved IPv4; do not follow redirects to another host.
  curl -4 -fsSI --http2 --tlsv1.3 --resolve "$d:443:$ip" --connect-timeout 2 --max-time 6 "https://$d/" >"$hdr" 2>/dev/null || { rm -f "$hdr" "$tls" "$cert"; echo '  HTTPS / HTTP2 连接失败'; return 1; }
  # Use the identical IPv4 that curl tested.  Do not let OpenSSL silently prefer a broken IPv6 route.
  timeout 10 openssl s_client -connect "$ip:443" -servername "$d" -alpn h2 -tls1_3 </dev/null >"$tls" 2>&1
  if grep -Eqi '^(server: *(cloudflare|akamaighost|bunnycdn|cdn77)|cf-ray:|x-amz-cf-id:|x-amz-cf-pop:|x-cache:.*cloudfront|x-served-by:.*fastly|via:.*cloudfront)' "$hdr"; then
    rm -f "$hdr" "$tls" "$cert"; echo '  检测到第三方 CDN 响应特征'; return 2
  fi
  grep -Eqi 'TLSv1\.3' "$tls" && tls13=是 || tls13=否
  grep -Eqi 'ALPN protocol: h2' "$tls" && h2=是 || h2=否
  # OpenSSL 1.1/3.x use several labels: "X25519", "ECDH, X25519", or PQ-hybrid "X25519MLKEM768".
  grep -Eqi '(Server Temp Key:.*X25519|Peer Temp Key:.*X25519|X25519MLKEM)' "$tls" && x25519=是 || x25519=否
  sed -n '/-----BEGIN CERTIFICATE-----/,/-----END CERTIFICATE-----/p' "$tls" >"$cert"
  openssl x509 -in "$cert" -noout -checkhost "$d" 2>/dev/null | grep -qi 'does match' && san=是 || san=否
  [ "$tls13" = 是 ] && [ "$h2" = 是 ] && [ "$x25519" = 是 ] && [ "$san" = 是 ] || { local diag; diag=$(grep -Ei '(Protocol|ALPN|Temp Key|X25519)' "$tls" | tr '\n' ';' | head -c 300); rm -f "$hdr" "$tls" "$cert"; echo "  条件未全满足：TLS1.3=$tls13，H2=$h2，X25519=$x25519，证书SAN=$san；握手：${diag:-无可读字段}"; return 3; }
  rm -f "$hdr" "$tls" "$cert"; echo "  通过：$d → $ip，TCP RTT 中位数 ${ms} ms（${samples[*]}），证书 SAN 覆盖=是"; return 0
}
sni_archive_begin() { SNI_ARCHIVE="$SBX_HOME/sni-archive/$(date +%Y%m%d-%H%M%S)-${1}.tsv"; mkdir -p "$SBX_HOME/sni-archive"; printf 'time\tsource\tdomain\tresult\tdetail\n' >"$SNI_ARCHIVE"; }
sni_normalize_db() { # v1 records lacked category; transparently mark them as cold/trusted
  local db="$SBX_HOME/sni-candidates.tsv" tmp
  [ -s "$db" ] || return 0; awk -F'\t' 'NF==6 {print $1 "\t冷门可信\t" $2 "\t" $3 "\t" $4 "\t" $5 "\t" $6; next} NF>=7 {$2=($2=="热门自有" ? "热门可信" : $2); print}' OFS='\t' "$db" >"$db.tmp" && mv "$db.tmp" "$db"
}
sni_record_candidate() { # domain, category, source, human-readable purpose; replace an old record
  local d=$1 category=$2 source=$3 purpose=$4 db="$SBX_HOME/sni-candidates.tsv" tmp
  mkdir -p "$SBX_HOME"; touch "$db"; sni_normalize_db; tmp=$(mktemp)
  awk -F'\t' -v d="$d" '$1 != d' "$db" >"$tmp"
  printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$d" "$category" "$source" "$purpose" "$SNI_LAST_IP" "$SNI_LAST_RTT" "$(date -Is)" >>"$tmp"
  mv "$tmp" "$db"; sni_sort_active
}
sni_cn_reachability() { # 0: absent from the maintained mainland-China block list; 1: listed; 2: list unavailable
  local d=$1 candidate cache="$SBX_HOME/cn-blocked-domains.txt" tmp
  mkdir -p "$SBX_HOME"
  if [ ! -s "$cache" ] || [ "$(find "$cache" -mtime +7 -print 2>/dev/null)" ]; then
    tmp=$(mktemp)
    curl -fsSL --connect-timeout 8 --max-time 35 'https://github.com/Loyalsoldier/cn-blocked-domain/raw/release/domains.txt' -o "$tmp" 2>/dev/null && grep -Eq '^[A-Za-z0-9.-]+$' "$tmp" && mv "$tmp" "$cache" || { rm -f "$tmp"; return 2; }
  fi
  candidate=$d
  while :; do
    grep -Fxi "$candidate" "$cache" >/dev/null && return 1
    [[ "$candidate" = *.* ]] || break; candidate=${candidate#*.}
  done
  return 0
}
sni_history_record() { # Latest result + cumulative counts, bound to the probing server's location.
  local d=$1 source=$2 rc=$3 detail=$4 db="$SBX_HOME/sni-history.json" tmp reason ttl now
  now=$(date +%s)
  case "$rc:$detail" in
    0:*) reason=pass; ttl=0;;
    4:*) reason=latency; ttl=21600;;
    2:*) reason=cdn; ttl=604800;;
    3:*) reason=tls; ttl=86400;;
    5:*) reason=blocklist; ttl=21600;;
    6:*) reason=cdn_check_unavailable; ttl=600;;
    *DNS*) reason=dns; ttl=3600;;
    *) reason=connect; ttl=1800;;
  esac
  [ -s "$db" ] || printf '{}\n' >"$db"
  tmp=$(mktemp)
  jq --arg d "$d" --arg src "$source" --arg reason "$reason" --arg detail "$detail" --arg scope "${SNI_SCAN_SCOPE:-manual}" --arg rtt "${SNI_LAST_RTT:-}" --argjson now "$now" --argjson ttl "$ttl" --argjson ok "$([ "$rc" = 0 ] && echo true || echo false)" '
    .[$d] = ((.[$d] // {passes:0,failures:0}) |
      .passes += (if $ok then 1 else 0 end) | .failures += (if $ok then 0 else 1 end) |
      .last=$now | .retry_after=($now+$ttl) | .reason=$reason | .detail=$detail | .source=$src | .scope=$scope |
      if ($rtt|length)>0 then .rtt_min=([.rtt_min,($rtt|tonumber)]|map(select(.!=null))|min) |
        .rtt_max=([.rtt_max,($rtt|tonumber)]|map(select(.!=null))|max) else . end)' "$db" >"$tmp" && mv "$tmp" "$db"
  rm -f "$tmp"
}
sni_cached_failure() {
  [ -s "$SBX_HOME/sni-history.json" ] || return 1
  jq -e --arg d "$1" --arg scope "${SNI_SCAN_SCOPE:-manual}" --argjson now "$(date +%s)" '.[$d] | .scope==$scope and .reason!="pass" and .retry_after>$now' "$SBX_HOME/sni-history.json" >/dev/null 2>&1
}
sni_history_summary() {
  [ -s "$SBX_HOME/sni-history.json" ] || return 0
  jq -r --arg d "$1" '.[$d] | select(.!=null) | "    历史：通过 \(.passes) / 失败 \(.failures) · RTT \(.rtt_min // "—")–\(.rtt_max // "—") ms · 最近 \(.reason)" + (if (.passes+.failures)<3 then " · 样本不足" else "" end)' "$SBX_HOME/sni-history.json"
}
sni_probe() { # Explicit selection/revalidation always bypasses discovery's failure cache.
  # Do not call test_sni in $(...) -- that would put SNI_LAST_IP/RTT in a subshell and lose them.
  local d=$1 source=$2 detail rc probe_log list="$SBX_HOME/sni_candidates.txt" result purpose=${SNI_PURPOSE:-"手动/未标注来源"} category=${SNI_CATEGORY:-冷门可信}
  SNI_LAST_RTT=; SNI_LAST_IP=
  if [ "$source" = popular-owned ]; then
    probe_log=$(mktemp); test_sni "$d" official >"$probe_log"; rc=$?; detail=$(<"$probe_log"); rm -f "$probe_log"
  else
    sni_cn_reachability "$d"; rc=$?
    if [ "$rc" -eq 1 ]; then detail='  中国大陆屏蔽名单命中，未加入候选'; rc=5
    elif [ "$rc" -eq 2 ]; then detail='  无法取得中国大陆可访问性名单，保守起见未加入候选'; rc=5
    else probe_log=$(mktemp); test_sni "$d" >"$probe_log"; rc=$?; detail=$(<"$probe_log"); rm -f "$probe_log"; fi
  fi
  echo "$detail"
  sni_history_record "$d" "$source" "$rc" "$detail"
  if [ "$rc" -ne 0 ] && [ -s "$SBX_HOME/sni-candidates.tsv" ]; then
    awk -F'\t' -v d="$d" '$1!=d' "$SBX_HOME/sni-candidates.tsv" >"$SBX_HOME/sni-candidates.tsv.tmp" && mv "$SBX_HOME/sni-candidates.tsv.tmp" "$SBX_HOME/sni-candidates.tsv"
    sni_sort_active
  fi
  result=$([ "$rc" -eq 0 ] && echo pass || echo reject)
  case "$source" in majestic-*) result=$([ "$rc" -eq 0 ] && echo pass_untrusted || echo reject);; esac
  printf '%s\t%s\t%s\t%s\t%s\n' "$(date -Is)" "$source" "$d" "$result" "$(tr '\n' ' ' <<<"$detail")" >>"$SNI_ARCHIVE"
  if [ "$rc" -eq 0 ] && [[ "$source" != majestic-* ]]; then touch "$list"; grep -Fqx "$d" "$list" || printf '%s\n' "$d" >>"$list"; sni_record_candidate "$d" "$category" "$source" "$purpose"; fi
  return "$rc"
}
sni_domain_sane() { # conservative prefilter: a domain must still pass live TLS/CDN checks afterwards
  local d=${1,,}
  [[ "$d" =~ (casino|bet|poker|bingo|slot|gambl|adult|porn|sex|escort|xxx|crypto|coin|token|nft|forex|trade|broker|bank|pay|wallet|loan|credit|insurance|ads|adserver|analytics|track|telemetry|click|short|bit\.ly|tinyurl|dyn|ddns|duckdns|no-ip|blogspot|wordpress|wixsite|weebly|github\.io) ]] && return 1
  [[ "$d" =~ ^(www\.)?(google|gstatic|facebook|instagram|youtube|microsoft|apple|icloud|yahoo|cloudflare|amazonaws|amazon|netflix)\. ]] && return 1
  return 0
}
sni_recommended_rows() { # Sorted view only: keep the on-disk candidate schema unchanged.
  local db="$SBX_HOME/sni-candidates.tsv" hist
  [ -s "$db" ] || return 0
  hist=$(mktemp)
  if [ -s "$SBX_HOME/sni-history.json" ]; then
    jq -r 'to_entries[] | [.key,.value.passes,.value.failures,(.value.rtt_min//0),(.value.rtt_max//0)] | @tsv' "$SBX_HOME/sni-history.json" >"$hist"
  fi
  # Smoothed failure penalty (0–20 ms) + observed spread penalty (at most 5 ms).
  # Few measurements deliberately retain uncertainty rather than claiming 100% stability.
  awk -F'\t' 'BEGIN{OFS="\t"}
    FILENAME==ARGV[1] {p[$1]=$2;f[$1]=$3;spread[$1]=$5-$4;next}
    {penalty=20*(f[$1]+1)/(p[$1]+f[$1]+2); jitter=spread[$1];if(jitter>5)jitter=5;
     score=($2=="热门可信" ? $6+penalty+jitter : $6);print score,$0}' "$hist" "$db" |
    sort -t$'\t' -k1,1n -k7,7n -k2,2 | cut -f2-
  rm -f "$hist"
}
select_candidate_sni() { # $1 category
  local wanted=$1 db="$SBX_HOME/sni-candidates.tsv" line d choice=0 selected; local -a domains=()
  sni_normalize_db; [ -s "$db" ] || return 1; sni_sort_active
  while IFS=$'\t' read -r d category source purpose ip rtt verified; do
    if [ "$wanted" = custom ]; then [ "$source" = import ] || continue
    else [ "$source" != import ] && [ "$category" = "$wanted" ] || continue; fi
    [[ "$rtt" =~ ^[0-9]+([.][0-9]+)?$ ]] || continue
    domains+=("$d")
    ui_item "${#domains[@]}" "$d  · RTT ${rtt}ms"
    printf '      %s（%s，%s）\n' "$purpose" "$source" "$ip"
    [ "$wanted" != 热门可信 ] || sni_history_summary "$d"
  done < <(sni_recommended_rows)
  [ "${#domains[@]}" -gt 0 ] || return 1
  read -r -p '选择编号 [1]（0 返回）：' choice; choice=${choice:-1}; [[ "$choice" =~ ^[0-9]+$ ]] && [ "$choice" -ge 1 ] && [ "$choice" -le "${#domains[@]}" ] || return 2
  DOMAIN=${domains[$((choice-1))]}
  selected=$(awk -F'\t' -v d="$DOMAIN" '$1==d {print;exit}' "$db")
  IFS=$'\t' read -r d SNI_CATEGORY source SNI_PURPOSE ip rtt verified <<<"$selected"
  echo "建节点前复测：$DOMAIN"
  sni_archive_begin selected-retest
  if ! sni_probe "$DOMAIN" "$source"; then
    awk -F'\t' -v d="$DOMAIN" '$1!=d' "$db" >"$db.tmp" && mv "$db.tmp" "$db"
    sni_sort_active; die '复测未通过，已移除该候选，请重新选择。'; return 2
  fi
  sni_sort_active
  return 0
}
select_or_discover_sni() { # $1 category, $2 user-facing source name, $3 discovery function
  local category=$1 source_name=$2 discover=$3 confirm rc
  select_candidate_sni "$category"; rc=$?; [ "$rc" -eq 0 ] && return 0; [ "$rc" -eq 2 ] && return 1
  echo -e "${YEL}暂无可用的${category}候选。${OFF}"
  read -r -p "是否现在检测${source_name}？[Y/n] " confirm
  [[ -z "$confirm" || "$confirm" =~ ^[Yy]$ ]] || return 1
  "$discover" || return 1
  select_candidate_sni "$category" || { die "检测完成后仍没有可用的${category}候选。可返回 12 → 3 直接粘贴自定义域名。"; return 1; }
}
select_reality_sni() {
  local geo choice own_domain
  ui_title '选择 SNI'
  geo=$(curl -fsS --max-time 4 https://ipapi.co/country_name/ 2>/dev/null || true)
  echo "服务器位置：${geo:-未知}。候选的实际质量以本机探测结果为准。"
  ui_section '候选库 · 冷门按 RTT / 热门兼顾历史稳定性，选中后复测'
  ui_item 1 '冷门可信    当地机构与站点'
  ui_item 2 '热门可信    品牌多入口 / 延迟与稳定性推荐'
  ui_item 3 '自定义域名  选择已导入 / 添加新域名'
  own_domain=$(cat "$CADDY_DIR/domain" 2>/dev/null || true)
  ui_section '自有与手动'
  ui_item 4 "偷自己      自有域名回落${own_domain:+（$own_domain）}"
  ui_item 5 '手动输入    立即测试域名'
  ui_rule
  read -r -p '> ' choice
  case "$choice" in
    1) select_or_discover_sni 冷门可信 '当地可信机构池' sni_institution_discovery || return 1;;
    2) select_or_discover_sni 热门可信 '热门官方品牌站点池' sni_hot_discovery || return 1;;
    3) select_or_discover_sni custom '自定义域名' sni_import || return 1;;
    4) if [ -z "$own_domain" ]; then
         caddy_self_domain || return 1
         own_domain=$(cat "$CADDY_DIR/domain" 2>/dev/null)
       fi
       [ -n "$own_domain" ] || return 1
       DOMAIN=$own_domain
       test_sni "$DOMAIN" official || { die '自有域名尚未通过 HTTPS 检测；请运行 journalctl -u sbx-caddy.service -n 80 --no-pager 查看证书日志，签发完成后重试。'; return 1; };;
    5) read -r -p 'SNI 域名：' DOMAIN; test_sni "$DOMAIN" || { die '测试未通过，已取消创建。'; return 1; };;
    *) return 1;; esac
  echo "已选择 SNI：$DOMAIN"
}
sni_institution_discovery() {
  local geo city country data line name url kind host tested=0 passed=0 list="$SBX_HOME/sni_candidates.txt" max=120
  geo=$(curl -fsS --max-time 8 https://ipapi.co/json/ 2>/dev/null || true)
  city=$(jq -r '.city // empty' <<<"$geo" 2>/dev/null); country=$(jq -r '.country_code // empty' <<<"$geo" 2>/dev/null)
  if [ -z "$city" ]; then
    geo=$(curl -fsS --max-time 8 https://ipwho.is/ 2>/dev/null || true)
    city=$(jq -r '.city // empty' <<<"$geo" 2>/dev/null); country=$(jq -r '.country_code // empty' <<<"$geo" 2>/dev/null)
  fi
  if [ -z "$city" ]; then
    geo=$(curl -fsS --max-time 8 https://ipinfo.io/json 2>/dev/null || true)
    city=$(jq -r '.city // empty' <<<"$geo" 2>/dev/null); country=$(jq -r '.country // empty' <<<"$geo" 2>/dev/null)
  fi
  if [ -z "$city" ]; then
    echo '自动定位不可用（常见原因是 API 限流或 VPS 网络限制）。'
    read -r -p '请输入 VPS 城市（例如 Los Angeles）：' city
    read -r -p '请输入国家代码（例如 US，可留空）：' country
    [ -n "$city" ] || { die '未提供城市。'; return; }
  fi
  local region tier filter rows tmp seen source cached=0 snapshot
  region=$(jq -r '.region // empty' <<<"$geo" 2>/dev/null)
  [[ "$country" =~ ^[A-Za-z]{2}$ ]] || { read -r -p '国家代码（如 US）：' country; }
  [[ "$country" =~ ^[A-Za-z]{2}$ ]] || { die '国家代码无效。'; return 1; }; country=${country^^}
  echo "可信来源：OpenAlex 机构 + PeeringDB 数据中心官网。位置：$city, $country"
  echo "历史复测 → 同城 → 同地区 → 同国家；合格 10 个即停止，最多实测 $max 个。"
  echo "机构位置仅决定顺序，最终仍要求三次 TCP 握手中位数 ≤ ${SNI_MAX_RTT_MS}ms。"
  read -r -p '确认开始扫描？[Y/n] ' confirm; [[ -z "$confirm" || "$confirm" =~ ^[Yy]$ ]] || return
  sni_archive_begin cold-local; SNI_SCAN_SCOPE="$city/$country"
  tmp=$(mktemp -d); seen="$tmp/seen"; touch "$seen"
  snapshot="$tmp/previous"; [ ! -s "$SBX_HOME/sni-candidates.tsv" ] || cp "$SBX_HOME/sni-candidates.tsv" "$snapshot"
  if [ -s "$snapshot" ]; then
    echo '── 历史冷门候选复测 ──'
    while IFS=$'\t' read -r host kind source name ip rtt verified; do
      [ "$kind" = 冷门可信 ] && [ "$source" != import ] || continue
      echo "$host" >>"$seen"
      if sni_cached_failure "$host"; then cached=$((cached+1)); continue; fi
      tested=$((tested+1)); SNI_CATEGORY=冷门可信; SNI_PURPOSE=$name
      echo "[$tested/$max] $host（历史复测）"; sni_probe "$host" "$source" && passed=$((passed+1))
      [ "$tested" -lt 5 ] || break
    done <"$snapshot"
  fi
  for tier in city region country; do
    [ "$passed" -lt 10 ] && [ "$tested" -lt "$max" ] || break
    [ "$tier" != region ] || [ -n "$region" ] || continue
    case "$tier" in city) filter="country_code:$country,geo.city:$city";; region) filter="country_code:$country,geo.region:$region";; country) filter="country_code:$country";; esac
    echo; echo "── 地域层级：$tier（$city / ${region:-无地区信息} / $country）──"
    rows="$tmp/$tier.tsv"; : >"$rows"
    data=$(curl -fsS --connect-timeout 5 --max-time 20 -G 'https://api.openalex.org/institutions' --data-urlencode "filter=$filter" --data-urlencode 'sort=cited_by_count:desc' --data-urlencode 'per-page=100' 2>/dev/null)
    if jq -e '.results | type=="array"' <<<"$data" >/dev/null 2>&1; then
      jq -r '.results[] | select(.homepage_url!=null) | [.homepage_url,"institution",(.display_name+"（"+(.type//"机构")+"；"+(.geo.city//"未知城市")+"）官方主页")] | @tsv' <<<"$data" >>"$rows"
    else echo '  OpenAlex 当前层级不可用，继续其他来源。'; fi
    local -a args=(--data-urlencode "country=$country" --data-urlencode 'limit=100')
    [ "$tier" != city ] || args+=(--data-urlencode "city=$city")
    if [ "$tier" != region ]; then
      data=$(curl -fsS --connect-timeout 5 --max-time 20 -G 'https://www.peeringdb.com/api/fac' "${args[@]}" 2>/dev/null)
      if jq -e '.data | type=="array"' <<<"$data" >/dev/null 2>&1; then
        jq -r '.data[] | select(.website!=null and .website!="") | [.website,"peeringdb",(.name+"（数据中心；"+(.city//"未知城市")+"）官方主页")] | @tsv' <<<"$data" >>"$rows"
      else echo '  PeeringDB 当前层级不可用，继续已有来源。'; fi
    fi
    while IFS=$'\t' read -r url source name; do
      host=$(sed -E 's#^https?://([^/:]+).*#\1#' <<<"$url" | tr '[:upper:]' '[:lower:]')
      [[ "$host" =~ ^[a-z0-9.-]+$ && "$host" != *.cn && "$host" != cn ]] || continue
      sni_domain_sane "$host" || continue
      grep -Fqx "$host" "$seen" && continue; echo "$host" >>"$seen"
      if sni_cached_failure "$host"; then cached=$((cached+1)); printf '%s\t%s\t%s\tcached\trecent failure\n' "$(date -Is)" "$source" "$host" >>"$SNI_ARCHIVE"; continue; fi
      tested=$((tested+1)); echo; echo "[$tested/$max] $host · $name"
      SNI_CATEGORY=冷门可信; SNI_PURPOSE="$name（发现层级：$tier）"
      sni_probe "$host" "$source" && passed=$((passed+1))
      [ "$tested" -lt "$max" ] && [ "$passed" -lt 10 ] || break
    done <"$rows"
  done
  rm -rf "$tmp"; unset SNI_SCAN_SCOPE; sni_sort_active
  echo "完成：实测 $tested，合格 $passed，跳过缓存失败 $cached。候选按 RTT 排序。"
}
sni_mirror_discovery() { # extracts domains only from official distribution mirror directories, never from IP enumeration
  local source data host tested=0 passed=0 max=40 list="$SBX_HOME/sni_candidates.txt"
  echo -e "${YEL}可信下载基础设施来源：Ubuntu / Debian 官方镜像目录。最多测试 $max 个去重域名。${OFF}"
  echo '这些是公开登记的镜像与下载基础设施，不是随机小站；仍会逐项执行 TLS、H2、X25519、CDN 与延迟筛选。'
  read -r -p '确认开始扫描？[Y/n] ' confirm; [[ -z "$confirm" || "$confirm" =~ ^[Yy]$ ]] || return; sni_archive_begin mirrors
  mkdir -p "$SBX_HOME"; touch "$list"
  for source in 'https://launchpad.net/ubuntu/+archivemirrors' 'https://www.debian.org/mirror/list'; do
    echo "读取官方目录：$source"
    data=$(curl -fsSL --max-time 20 "$source" 2>/dev/null || true); [ -n "$data" ] || continue
    while IFS= read -r host; do
      [[ "$host" =~ ^[a-z0-9.-]+$ ]] || continue
      tested=$((tested+1)); echo -e "\n${CYA}[$tested/$max] $host${OFF}"
      SNI_CATEGORY=热门可信; SNI_PURPOSE="Ubuntu / Debian 官方镜像目录登记的常用下载基础设施"; if sni_probe "$host" mirrors; then passed=$((passed+1)); fi
      [ "$tested" -ge "$max" ] && break 2
    done < <(grep -Eo 'https?://[A-Za-z0-9._-]+' <<<"$data" | sed -E 's#https?://##' | tr '[:upper:]' '[:lower:]' | sort -u)
  done
  sort -u -o "$list" "$list"
  echo -e "${GRN}完成：测试 $tested 个，新增 $passed 个候选。${OFF}"
  echo "候选库：$list"
}
sni_tranco_search() { # historical function name; Majestic is deliberately the ranking source used in production
  local label=$1 low=$2 high=$3 data host tested=0 passed=0 max=40 majestic
  echo -e "${YEL}$label：从 Majestic Million 排名 $low–$high 进行技术研究，最多实测 $max 个。${OFF}"
  echo '注意：排名不代表站点可信；通过项只写入扫描归档，不会自动加入活跃 SNI 候选库。'
  read -r -p '确认开始扫描？[Y/n] ' confirm; [[ -z "$confirm" || "$confirm" =~ ^[Yy]$ ]] || return; sni_archive_begin "majestic-$low-$high"
  majestic=$(curl -fsSL -A 'Mozilla/5.0 (compatible; SBX/1.0)' --max-time 120 https://downloads.majestic.com/majestic_million.csv 2>/dev/null || true)
  grep -qE '^GlobalRank,' <<<"$majestic" || { die 'Majestic Million 未返回有效 CSV；请检查 downloads.majestic.com 的访问。'; return; }
  data=$(awk -F, 'NR>1 && $1 ~ /^[0-9]+$/ {d=$3; gsub(/"/, "", d); print $1 "," d}' <<<"$majestic")
  while IFS= read -r host; do
    [[ "$host" =~ ^[a-z0-9.-]+$ ]] || continue; sni_domain_sane "$host" || continue; tested=$((tested+1)); echo -e "\n${CYA}[$tested/$max] $host${OFF}"
    sni_probe "$host" "majestic-$low-$high" && passed=$((passed+1)); [ "$tested" -ge "$max" ] && break
  done < <(awk -F, -v lo="$low" -v hi="$high" '$1>=lo && $1<=hi {d=$2; gsub(/^https?:\/\//,"",d); sub(/\/.*$/, "", d); if (d ~ /^[A-Za-z0-9.-]+$/) print tolower(d)}' <<<"$data" | { command -v shuf >/dev/null && shuf -n "$max" || head -n "$max"; })
  [ "$tested" -gt 0 ] || { die "Majestic 排名中没有符合业务预筛选的 $low–$high 候选。"; return; }
  echo -e "${GRN}完成：测试 $tested 个，新增/确认 $passed 个候选。归档：$SNI_ARCHIVE${OFF}"
}

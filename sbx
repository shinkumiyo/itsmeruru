require_caddy_domain() {
  echo '  正在读取自有域名配置 …'
  TLS_DOMAIN=$(cat "$CADDY_DIR/domain" 2>/dev/null || true)
  if [ -z "$TLS_DOMAIN" ]; then
    echo '此节点需要自己的域名和有效证书，现在进入 Caddy 自动配置。'
    caddy_self_domain || return 1
    TLS_DOMAIN=$(cat "$CADDY_DIR/domain" 2>/dev/null || true)
  fi
  echo "  自有域名：$TLS_DOMAIN；检查 Caddy 服务 …"
  [ -n "$TLS_DOMAIN" ] && timeout 5 systemctl is-active --quiet sbx-caddy.service || { die 'Caddy 未运行或服务查询超时，请先检查自有域名服务。'; return 1; }
  return 0
}
find_caddy_certificate() {
  local cert key tries candidates
  TLS_CERT=; TLS_KEY=
  echo "  查找 $TLS_DOMAIN 的 Caddy 证书（最多 3 次，每次搜索限时 4 秒）…"
  for tries in 1 2 3; do
    echo "  证书检查 $tries / 3 …"
    candidates=$(timeout 4 find "$CADDY_DIR" /caddy /root/.local/share/caddy /var/lib/caddy /.local/share/caddy -maxdepth 7 -type f -name "$TLS_DOMAIN.crt" 2>/dev/null || true)
    while IFS= read -r cert; do
      [ -n "$cert" ] || continue
      key=${cert%.crt}.key
      [ -s "$key" ] || continue
      timeout 3 openssl x509 -in "$cert" -noout -checkend 60 >/dev/null 2>&1 || continue
      timeout 3 openssl x509 -in "$cert" -noout -checkhost "$TLS_DOMAIN" 2>/dev/null | grep -q 'does match' || continue
      TLS_CERT=$cert; TLS_KEY=$key; echo '  已找到有效证书。'; return 0
    done <<<"$candidates"
    [ "$tries" = 3 ] || sleep 2
  done
  die '未找到有效证书：可能尚未签发、已过期或使用了自定义存储目录。请查看 journalctl -u sbx-caddy.service -n 80 --no-pager。'
  return 1
}
caddy_ws_sync() { # Reconstruct WS routes from metadata; roll back both files on reload failure.
  local tmp m domain p path current
  current=$(cat "$CADDY_DIR/domain" 2>/dev/null || true)
  [ -f "$CADDY_DIR/Caddyfile" ] || return 0
  tmp=$(mktemp -d) || return 1
  cp "$CADDY_DIR/Caddyfile" "$tmp/main" || { rm -rf "$tmp"; return 1; }
  [ ! -f "$CADDY_DIR/ws-routes.caddy" ] || cp "$CADDY_DIR/ws-routes.caddy" "$tmp/routes"
  : >"$tmp/new-routes"
  for m in "$META"/*.meta; do
    [ -f "$m" ] || continue
    [ "$(jq -r .type "$m")" = vless-ws ] || continue
    domain=$(jq -r .domain "$m"); p=$(jq -r .port "$m"); path=$(jq -r .path "$m")
    [ "$domain" = "$current" ] && port "$p" && [[ "$path" =~ ^/[A-Za-z0-9_-]+$ ]] || { rm -rf "$tmp"; die 'WS 节点域名、路径或端口与 Caddy 不一致。'; return 1; }
    printf 'reverse_proxy %s 127.0.0.1:%s\n' "$path" "$p" >>"$tmp/new-routes"
  done
  if [ ! -s "$tmp/new-routes" ] && [ ! -f "$CADDY_DIR/ws-routes.caddy" ]; then rm -rf "$tmp"; return 0; fi
  if ! grep -Fq "import $CADDY_DIR/ws-routes.caddy" "$CADDY_DIR/Caddyfile"; then
    # Upgrade only our generated single-site Caddyfile, never guess where to inject.
    [ "$(grep -c '^  header -Server$' "$CADDY_DIR/Caddyfile")" = 1 ] || { rm -rf "$tmp"; die 'Caddyfile 不是可自动迁移的 SBX 配置。'; return 1; }
    awk -v inc="  import $CADDY_DIR/ws-routes.caddy" '{print} /^  header -Server$/ {print inc}' "$tmp/main" >"$CADDY_DIR/Caddyfile"
  fi
  mv "$tmp/new-routes" "$CADDY_DIR/ws-routes.caddy"
  if "$CADDY_BIN" validate --config "$CADDY_DIR/Caddyfile" --adapter caddyfile && { ! systemctl is-active --quiet sbx-caddy.service || systemctl reload sbx-caddy.service; }; then rm -rf "$tmp"; return 0; fi
  cp "$tmp/main" "$CADDY_DIR/Caddyfile"
  if [ -f "$tmp/routes" ]; then cp "$tmp/routes" "$CADDY_DIR/ws-routes.caddy"; else rm -f "$CADDY_DIR/ws-routes.caddy"; fi
  systemctl reload sbx-caddy.service >/dev/null 2>&1 || true
  rm -rf "$tmp"; die 'WS 反代应用失败，Caddy 已恢复原配置。'
}
add_trojan() {
  local f pass
  ui_title '创建 Trojan + TLS'
  require_caddy_domain && find_caddy_certificate || return 1
  echo "证书域名：$TLS_DOMAIN；Caddy 保留 443，Trojan 使用独立 TCP 端口。"
  ask_common || { die '节点名称或端口无效。'; return 1; }
  pass=$(openssl rand -hex 16); f="$CONF/$NAME.json"
  jq -n --arg tag "$NAME" --argjson p "$PORT" --arg pass "$pass" --arg d "$TLS_DOMAIN" --arg cert "$TLS_CERT" --arg key "$TLS_KEY" '{inbounds:[{type:"trojan",tag:$tag,listen:"::",listen_port:$p,users:[{password:$pass}],tls:{enabled:true,server_name:$d,certificate_path:$cert,key_path:$key}}]}' >"$f" || return 1
  jq -n --arg name "$NAME" --argjson port "$PORT" --arg password "$pass" --arg domain "$TLS_DOMAIN" '{name:$name,type:"trojan",port:$port,password:$password,domain:$domain}' >"$META/$NAME.meta"
  if check_commit "$f"; then firewall_open tcp "$PORT"; show_node "$NAME"
  else rm -f "$META/$NAME.meta"; return 1; fi

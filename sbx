    if [ -s "$backup" ]; then mv "$backup" "$CADDY_DIR/Caddyfile"; [ "$was_running" = 0 ] || systemctl reload sbx-caddy.service
    else rm -f "$backup" "$CADDY_DIR/Caddyfile"; fi
    die 'Caddy 应用失败，已恢复原配置；日志：journalctl -u sbx-caddy.service -n 80 --no-pager'; return 1
  fi
  echo -e "${GRN}Caddy 已启动。证书申请日志：journalctl -u sbx-caddy.service -f${OFF}"
  echo "证书签发后，可在创建或修改 VLESS / AnyTLS 时选择“偷自己”。"
  echo "自有站点：https://$domain；REALITY 握手目标：$domain:443。"
  return 0
}
enable_bbr() { cat >/etc/sysctl.d/99-sbx-bbr.conf <<'EOF'
net.core.default_qdisc=fq

add_vless_ws() {
  local f id path
  ui_title '创建 VLESS + WS + TLS'
  require_caddy_domain || return 1
  # Caddy terminates TLS; a WS backend never needs access to Caddy's key files.
  echo "  检查本机 Caddy 的 HTTPS 证书 …"
  curl --noproxy '*' --resolve "$TLS_DOMAIN:443:127.0.0.1" --connect-timeout 2 --max-time 6 -sS -o /dev/null "https://$TLS_DOMAIN/" || { die '本机 HTTPS 尚未就绪或证书校验失败，请先检查 Caddy 证书日志。'; return 1; }
  echo "入口：$TLS_DOMAIN:443；下面的监听端口仅供 Caddy 本机反代，无需对外放行。"
  ask_common || { die '节点名称或端口无效。'; return 1; }
  id=$(uuid); path="/sbx-$(openssl rand -hex 12)"; f="$CONF/$NAME.json"
  jq -n --arg tag "$NAME" --argjson p "$PORT" --arg id "$id" --arg path "$path" '{inbounds:[{type:"vless",tag:$tag,listen:"127.0.0.1",listen_port:$p,users:[{uuid:$id}],transport:{type:"ws",path:$path}}]}' >"$f" || return 1
  jq -n --arg name "$NAME" --argjson port "$PORT" --arg uuid "$id" --arg domain "$TLS_DOMAIN" --arg path "$path" '{name:$name,type:"vless-ws",port:$port,uuid:$uuid,domain:$domain,path:$path,client_port:443}' >"$META/$NAME.meta"
  if check_commit "$f"; then
    if caddy_ws_sync; then show_node "$NAME"; return 0; fi
    rm -f "$f" "$META/$NAME.meta"; restart >/dev/null 2>&1
    return 1
  else rm -f "$META/$NAME.meta"; return 1; fi
}
